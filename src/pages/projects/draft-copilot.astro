          {shots.map((s, i) => (
            <div class:list={['dc-shots__panel', { 'dc-shots__panel--portrait': s.portrait }]} id={`shot-${s.id}`} role="tabpanel" aria-labelledby={`shot-tab-${s.id}`} hidden={i !== 0}>
              <figure class="shot"><img src={img(s.src)} width={s.w} height={s.h} loading="lazy" decoding="async" alt={s.alt} /><figcaption>{s.alt}</figcaption></figure>
              <div class="dc-shots__text"><h3>{s.title}</h3><p>{s.text}</p></div>
            </div>
          ))}
        </div>

        <div class="grid grid--3 dc-ops">
          {ops.map((o, i) => (
            <div class="feature reveal" style={`--i:${i}`}>
              <Icon name={o.icon} />
