---
import '@fontsource/anton';
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import Base from '../../layouts/Base.astro';
import CaseMeta from '../../components/CaseMeta.astro';
import CaseTrio from '../../components/CaseTrio.astro';
import Ticker from '../../components/draft/Ticker.astro';
import Icon from '../../components/Icon.astro';
import Dialog from '../../components/Dialog.astro';
import SectionHead from '../../components/SectionHead.astro';
import Stat from '../../components/Stat.astro';
import { projects, projectById } from '../../data/projects';
import { url } from '../../site.config';
import draft from '../../data/draft.json';
import { adpChart, LAST_PICK, MAX_RANK, POSITIONS, POS_NAME, SERIES_COLOR } from '../../scripts/draft-curves';

const p = projectById.draft;
const others = projects.filter((x) => x.id !== 'draft');
const repo = p.links.find((l) => l.kind === 'repo') ?? p.links[0];
const live = p.links.find((l) => l.kind === 'live') ?? p.links[0];
const img = (file: string) => url(`/images/projects/${file}`);
const guideUrl = 'https://x.com/fantasysmyth';
const initialChart = adpChart({ anchors: draft.anchors, superflexQb: draft.superflexQb, superflex: false, selected: 'RB', rank: 18 });

type IconName = 'dice' | 'table' | 'send' | 'flag' | 'trending-up' | 'layers' | 'shield' | 'globe' | 'lock' | 'user' | 'check' | 'eye' | 'cpu' | 'code' | 'book' | 'database' | 'wifi' | 'branch';

const features: { icon: IconName; title: string; text: string }[] = [
  { icon: 'dice', title: 'Survival odds', text: '400 simulated drafts per pick put a number on the chance a player is still there at your next turn, so you know when you can wait and when waiting loses him.' },
  { icon: 'table', title: 'The live board', text: 'Every pick mirrored in seconds, plus four shortlists of the best available by position, ordered by your strategy, with value and reach flagged against ADP.' },
  { icon: 'send', title: 'Plain-English chat', text: '"Olave or a third RB?" A short answer while you are on the clock and the full reasoning when you ask for more. Injuries and rookie context are priced in.' },
  { icon: 'flag', title: 'Injury flags', text: "Sleeper's live injury status rides along with every recommendation, weighted by draft-day severity: IR, PUP and Out burn a pick, while Questionable in August is a note, not a penalty." },
  { icon: 'trending-up', title: 'Rookie draft-capital logic', text: 'Rookies are weighted by where NFL teams actually drafted them, not camp hype: a top-8 dynasty-rookie rank earns a bonus from round 4, and every guide-ranked rookie gets late-round upside credit.' },
  { icon: 'layers', title: 'Strategy presets', text: 'RB-heavy, zero-RB, hero-RB, pure best-available, superflex and dynasty, switchable mid-draft. Every rule is a tunable knob rather than hard-coded behaviour.' },
  { icon: 'shield', title: 'Advises only', text: 'There is no code path that submits a pick, clicks a button in the draft room or automates an account. The Sleeper client is read-only, and the pick is always yours.' },
];

const platforms = [
  { name: 'Sleeper', pill: 'Live', tone: 'live', note: 'Reads the public API, no login at all' },
  { name: 'Yahoo', pill: 'Beta', tone: 'beta', note: "Through Yahoo's official OAuth sign-in" },
  { name: 'ESPN', pill: 'Experimental', tone: 'exp', note: 'Not yet supported for real drafts' },
  { name: 'NFL.com', pill: 'Coming later', tone: 'dim', note: 'Not supported yet' },
];

const r2 = [
  { pos: 'RB', v: 0.983 },
  { pos: 'WR', v: 0.981 },
  { pos: 'TE', v: 0.935 },
  { pos: 'QB', v: 0.847 },
];

const knobs = [
  { k: 'rb_target_top_n', v: '30', why: 'three RBs from the top ~30' },
  { k: 'rb_target_count', v: '3', why: 'bonus while still short of the target count' },
  { k: 'rb_dead_zone', v: '(30, 40)', why: 'the RB30-40 band, "mostly a waste of time"' },
  { k: 'rb_dead_zone_penalty', v: '2.0', why: 'VOR taken off a dead-zone RB' },
  { k: 'wr_sweet_rounds', v: '(3, 5)', why: 'rounds where a WR gets the sweet-spot bonus' },
  { k: 'wr_fade_pos_rank', v: '(5, 12)', why: '"WR5-12 range is not my favourite"' },
  { k: 'qb_target_pos_rank', v: '(7, 11)', why: 'the QB band the script waits for' },
  { k: 'qb_min_round', v: '7', why: 'before this, QB is heavily discounted' },
  { k: 'te2_penalty', v: '2.5', why: '"rather go backup-RB hunting than a TE2"' },
  { k: 'bench_targets', v: 'QB 2 · RB 5 · WR 5 · TE 1', why: 'bench shape worth ending the draft with' },
  { k: 'max_pos', v: 'QB 2 · RB 6 · WR 6 · TE 2 · K 1 · DEF 1', why: 'hard ceilings, because VOR alone builds ten WRs' },
  { k: 'urgency_weight', v: '0.6', why: 'weight on P(gone) × (value now − expected fallback)' },
  { k: 'reach_penalty_per_pick', v: '0.055', why: 'cost per pick drafted ahead of ADP, free inside 8 picks' },
  { k: 'value_bonus_per_pick', v: '0.045', why: 'reward for a faller, capped at 3.5' },
  { k: 'upside_weight_late', v: '0.42', why: 'weight on the 85th-percentile outcome, ramping from round 8' },
  { k: 'sim_runs', v: '400', why: 'Monte Carlo futures per pick' },
  { k: 'lookahead_discount', v: '0.85', why: 'weight on the expected board at your next pick' },
];

const presets = [
  { name: 'joel_rb_heavy', tag: 'default', text: 'RB/RB start, three RBs from the top ~30, WR in rounds 3 and 5, QB at the QB7-11 ADP band (or a late rusher), TE only at genuine best-player-available.' },
  { name: 'zero_rb', tag: '', text: 'Fade early RB; load WR/TE through round 5, attack RB value later.' },
  { name: 'hero_rb', tag: '', text: 'One elite RB in round 1, then WR/TE until RB value returns.' },
  { name: 'bpa', tag: '', text: 'Pure value: VOR plus ADP discipline, no positional scripting.' },
  { name: 'superflex', tag: 'auto-selected', text: 'Two-QB / superflex: QBs carry real positional value, take them early.' },
  { name: 'dynasty', tag: 'auto-selected', text: 'Dynasty: weight youth and multi-year outlook, discount ageing veterans.' },
];

const mcpTools = ['connect_draft', 'start_offline_mock', 'list_my_drafts', 'refresh', 'recommend', 'explain_player', 'compare_players', 'board', 'room', 'roster', 'get_strategy', 'set_strategy', 'bump_player', 'ban_player', 'record_feedback', 'review', 'guide_lookup', 'guide_strategy'];

const guideRows = [
  ['Big boards', 'PPR and half-PPR, 150 players each'],
  ['Positional ranks', '60 RB, 60 WR, 32 QB, 32 TE per format'],
  ['2025 adjusted PPG', "46 RB, 48 WR, 32 QB, 28 TE: the author's injury, snap and situation-adjusted numbers"],
  ['Top 50 stats', 'All 50, auto-tagged to the players they mention'],
  ['Dynasty rookies', '36'],
  ['Strategy', 'The page-11 round-by-round script, positional targets and fades, six rules'],
];

const sources = [
  { title: 'Sleeper public API', text: 'Read-only: draft picks, players and live injury status. No login.' },
  { title: 'Yahoo Fantasy (beta)', text: "Official OAuth. The service holds a read-only token you can revoke in Yahoo's settings." },
  { title: "Joel Smyth's 2026 Draft Guide", text: 'Parsed from PDF to JSON: rankings, adjusted PPG, stats and the written strategy.' },
  { title: 'Observed drafts', text: 'Every draft it watches is recorded to SQLite and refits the ADP curves for that league shape.' },
];

const ops: { icon: IconName; title: string; text: string; dialog?: string; dialogLabel?: string }[] = [
  { icon: 'globe', title: 'Hosting', text: 'A Dockerfile on python:3.12-slim. On Fly.io, one shared-cpu-1x machine with 512 MB, forced HTTPS and a health check on GET /api/ping; a Render blueprint is the alternative. One machine on purpose: v1 state is an in-process SQLite database.' },
  { icon: 'lock', title: 'Edge and headers', text: 'Vercel serves the landing site with no build step and rewrites /app and /api/* to the Fly app under a strict Content-Security-Policy, HSTS, nosniff and a referrer policy.' },
  { icon: 'shield', title: 'Abuse controls', text: 'Sessions are rate-limited by forwarded client IP: six new sessions an hour, read from X-Forwarded-For behind the proxy. Public chat runs with the LLM off by default and degrades to the built-in parser.' },
  { icon: 'user', title: 'Accounts', text: 'Google sign-in, so the service never sees a password; a draft archive, a review chat over a finished draft, and a saved strategy that every new draft starts from. Accounts are optional.' },
  { icon: 'check', title: 'Tests', text: '72 tests in five suites: the core engine (35), natural-language parsing (18), the LLM layer (8), the public server (6) and accounts (5).' },
  { icon: 'eye', title: 'The extension is a viewer', text: 'It asks only for storage and localhost access and mounts an iframe inside draft rooms. No tabs, webRequest or scripting permission, and it never reads the page.', dialog: 'extension', dialogLabel: 'Permissions and limits' },
];

const faq = [
  { q: 'Does it make picks?', a: 'No, and it cannot. There is no code path that submits a pick, clicks a button in the draft room or automates an account. It advises; you draft.' },
  { q: 'Does it see passwords?', a: "Never. Sleeper drafts are read through Sleeper's public API with no login. Yahoo uses Yahoo's own official OAuth page and the service receives a read-only token the user can revoke at any time. Google sign-in works the same way." },
  { q: 'What does it cost?', a: 'It is free. The landing page commits to announcing any change there first, with no surprise paywalls mid-season.' },
  { q: 'Is draft data stored?', a: 'Without an account a session is anonymous and expires after inactivity. With an account, drafts are archived until the user deletes them. The hosted v1 keeps its SQLite database inside the container, so a redeploy wipes live sessions; the deploy notes say so rather than promising persistence.' },
  { q: 'Can it be self-hosted?', a: 'Yes. The whole thing is open source, installs with one pip command and rehearses offline with ffbot mock. The hosted service runs the same code.' },
  { q: 'Where do the rankings come from?', a: "The value model is fit to Joel Smyth's 2026 Draft Guide, combined with live market ADP, injury data and Monte Carlo simulation. He does not endorse the project." },
];

const shots = [
  { id: 'panel', tab: 'Web panel', src: 'draft-copilot-panel.png', w: 1500, h: 940, portrait: false, alt: 'The Draft Copilot web panel: a 15-round draft board on the left with the user on the clock at pick 53, best available by position with tier counts, reach and value flags and survival odds on the right, and the chat below.', title: 'The panel on a wide screen', text: 'Draft board on the left, with your column highlighted and the clock on your pick. Best by position on the right: each column opens with its tier line ("T12 (5) · 5.6/12 gone · 70 left") and every player carries his projection, an ADP flag (on adp, reach 14, value +18), injury status and the simulated chance he is still there at your next pick.' },
  { id: 'sidebar', tab: 'Sidebar', src: 'draft-copilot-sidebar.png', w: 430, h: 900, portrait: true, alt: 'The narrow sidebar layout with Options, Board and Chat tabs, showing best available by position while the user is on the clock.', title: 'Docked beside the draft room', text: 'The same panel in its narrow layout, the shape the Chrome extension docks beside a Sleeper or Yahoo draft: Options, Board and Chat become tabs, and the shortlists stack by position. The sidebar can be dragged between 320 and 900 px wide and collapsed to a pill.' },
  { id: 'mobile', tab: 'Phone', src: 'draft-copilot-mobile.jpg', w: 360, h: 720, portrait: true, alt: 'The phone layout of the copilot: tabs for options, board and chat, with "1 pick until you\'re up" at the top.', title: 'On a phone', text: 'The web app at phone width: one pick until you are up, the script\'s positional target for the round, and the best available by position with the same flags. The hosted app needs nothing installed.' },
];
---
<Base title={`Draft Copilot: a live fantasy-football draft assistant · Sid Subramanian`} description={`${p.oneLiner} ${p.summary}`} theme="draft" ogImage={img('draft-copilot-cockpit.jpg')}>
  <div class="dc">
    <div class="container">
      <div class="proj-bar">
        <div class="row">
          <span class="badge">{p.period}</span>
          <span class="dc-status"><span class="dc-status__dot pulse" aria-hidden="true"></span>{p.status}</span>
        </div>
        <div class="cluster dc-stack" style="--cluster:6px">{p.stack.map((s) => <span class="chip">{s}</span>)}</div>
        <div class="proj-bar__links">
          {p.links.map((l) => (
            <a class="btn btn--ghost btn--sm" href={l.url}><Icon name={l.kind === 'repo' ? 'github' : 'arrow-up-right'} size={14} />{l.label}</a>
          ))}
        </div>
      </div>
    </div>

    <CaseMeta project={p} index={1} />

    <!-- 1. Hero -->
    <section class="hero dc-hero grain" id="top">
      <div class="hero__bg" aria-hidden="true">
        <img class="dc-hero__photo" src={img('turf-cc0.jpg')} alt="" width="1200" height="795" loading="eager" decoding="async" fetchpriority="high" data-parallax="0.1" />
        <div class="dc-hero__hash"></div>
        <div class="dc-hero__shade"></div>
        <div class="dc-hero__yards">{['10', '20', '30', '40', '50', '40', '30', '20', '10'].map((y) => <span>{y}</span>)}</div>
      </div>
      <div class="container dc-hero__inner">
        <span class="kicker reveal"><span class="dot"></span> Fantasy football · live draft assistant</span>
        <h1 class="reveal" style="--i:1">A live assistant for your fantasy draft</h1>
        <p class="lead reveal" style="--i:2">It watches every pick, runs the numbers and answers in plain English. Sleeper today, Yahoo in beta. It advises. You draft.</p>
        <div class="hero__actions reveal" style="--i:3">
          <a class="btn btn--primary btn--lg" href={live.url}>Open the hosted app <Icon name="arrow-up-right" class="arrow" /></a>
          <a class="btn btn--ghost btn--lg" href={repo.url}><Icon name="github" /> Source on GitHub</a>
        </div>
        <p class="dc-hero__fine reveal" style="--i:4">Free · no sign-up needed to draft · advisory only, it never picks for you</p>
        <Ticker />
        <figure class="shot dc-hero__shot reveal reveal--scale" style="--i:5">
          <img src={img('draft-copilot-cockpit.jpg')} width="1400" height="836" loading="eager" decoding="async" alt="The Draft Copilot mid-draft: a live board on the left with the user one pick from the clock, best available by position with survival odds and ADP flags on the right, and the chat below." />
          <figcaption>The copilot during a Sleeper-style mock draft: the live board, best available by position with "% left" survival odds, and the chat.</figcaption>
        </figure>
      </div>
    </section>

    <CaseTrio project={p} />

    <!-- Headline numbers -->
    <section class="dc-stats" aria-label="Headline numbers">
      <div class="container">
        <div class="stat-row">
          <Stat label="Simulated drafts per pick" value="400" count={400} />
          <Stat label="MCP tools for Claude" value="18" count={draft.mcpTools} />
          <Stat label="Tests" value="72" count={draft.tests} />
          <Stat label="Strategy presets" value="6" count={6} />
        </div>
      </div>
    </section>

    <!-- 2. What it does -->
    <section class="section" id="features">
      <div class="container">
        <SectionHead num="01" eyebrow="What it does" title="Seven things it does on the clock" lead="A cheat sheet is static. This keeps the math current as the room drafts, and it says why." />
        <div class="dc-rows">
          {features.map((f, i) => (
            <div class="dc-row reveal" style={`--i:${i}`}>
              <Icon name={f.icon} class="dc-row__ico" />
              <div class="dc-row__head"><span class="dc-row__idx">{String(i + 1).padStart(2, '0')}</span><h3>{f.title}</h3></div>
              <p>{f.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. Platforms -->
    <section class="dc-platforms" id="platforms" aria-label="Platforms">
      <div class="container">
        <div class="dc-hosts">
          {platforms.map((h, i) => (
            <div class:list={['dc-host reveal', { 'dc-host--dim': h.tone === 'dim' }]} style={`--i:${i}`}>
              <span class="dc-host__mark">{h.name}</span>
              <span class:list={['dc-pill', `dc-pill--${h.tone}`]}>{h.pill}</span>
              <span class="dc-host__note">{h.note}</span>
            </div>
          ))}
        </div>
        <p class="dc-platforms__note small muted reveal" style="--i:4">Sleeper needs no login at all. Yahoo connects through Yahoo's own official sign-in, so a password never touches the service. Platform names belong to their owners and are used only to describe compatibility.</p>
      </div>
    </section>

    <!-- 4. The model -->
    <section class="dc-stadium" id="model">
      <img class="dc-stadium__bg" src={img('stadium-cc0.jpg')} alt="" width="1280" height="960" loading="lazy" decoding="async" data-parallax="0.08" />
      <div class="container dc-stadium__inner">
        <span class="eyebrow reveal"><span class="eyebrow__num">02</span><span class="eyebrow__slash">/</span><span>The model</span></span>
        <h2 class="reveal" style="--i:1">Built on real draft data</h2>
        <p class="reveal" style="--i:2">Rankings from Joel Smyth's 2026 Draft Guide, a market baseline read from Sleeper, and the picks happening in your room. Four fitted components, nothing hidden: every number surfaces in the reasoning.</p>
      </div>
    </section>
    <section class="section section--tight dc-model-section">
      <div class="container">
        <div class="grid grid--2 dc-model">
          <article class="card card--hover reveal" style="--i:0">
            <span class="dc-model__num" aria-hidden="true">1</span>
            <h3>Value curves</h3>
            <p><code>ppg(rank) = A·(rank + r₀)^−b + C</code>, fit per position to the guide's 2025 adjusted PPG tables. The rank offset r₀ matters: real value curves are flat across the top few players, and an unshifted power law predicts 37 PPG for RB1 against an observed 24.8.</p>
            <div class="dc-r2" role="list" aria-label="Fit quality by position">
              {r2.map((r) => (
                <div class="dc-r2__row" role="listitem"><span class="dc-r2__pos">{r.pos}</span><span class="dc-r2__bar"><i style={`--v:${r.v}`}></i></span><span class="dc-r2__val">r² {r.v.toFixed(3)}</span></div>
              ))}
            </div>
          </article>
          <article class="card card--hover reveal" style="--i:1">
            <span class="dc-model__num" aria-hidden="true">2</span>
            <h3>Projections</h3>
            <p>A player's 2026 guide rank goes through that curve, then shrinks 28% toward his own 2025 adjusted PPG. Uncertainty is <code>sigma = floor + slope · ppg</code>, widened for rookies, for players with no 2025 baseline, and where the ranker and the player's own 2025 disagree.</p>
          </article>
          <article class="card card--hover reveal" style="--i:2">
            <span class="dc-model__num" aria-hidden="true">3</span>
            <h3>ADP, independent of the guide</h3>
            <p>Rule 1 in the guide is "don't draft off rankings without understanding ADP", so the market baseline must not come from the guide's opinions. Sleeper's <code>search_rank</code> gives a genuine within-position market order; that rank is pushed through consumption curves anchored to landmarks the guide states outright, and after about eight observed drafts of a league shape the curves are refit to what your rooms actually do.</p>
            <table class="dc-check" aria-label="The model reproduces the guide's own ADP examples">
              <thead><tr><th scope="col"></th><th scope="col">Guide says</th><th scope="col">Model says</th></tr></thead>
              <tbody>
                <tr><th scope="row">QB3 overall pick</th><td>55th</td><td class="num">55.0</td></tr>
                <tr><th scope="row">Parker Washington</th><td>"taken ~85th, I have him 62nd"</td><td class="num">ADP 84 · guide #62</td></tr>
              </tbody>
            </table>
          </article>
          <article class="card card--hover reveal" style="--i:3">
            <span class="dc-model__num" aria-hidden="true">4</span>
            <h3>Monte Carlo + VONA</h3>
            <p>400 simulated futures per pick, using an opponent model that tracks each rival's roster needs, whether they reach or wait for value, positional lean, and any run in progress. That yields survival probabilities and the expected board at your next pick.</p>
          </article>
        </div>
        <div class="dc-formula reveal" style="--i:1">
          <pre aria-label="The final score for each candidate"><code>score = <b>value now</b>   (VOR, roster-aware, + strategy terms)
      + <b>0.85 ×</b> expected board at your next pick
      + <b>urgency:</b> P(gone) × (his value − your expected fallback)</code></pre>
          <div>
            <p>The urgency term exists because a two-pick lookahead cannot see that taking the player who will be gone lets you collect the one who will not, three picks later. Without it the bot took a 60%-to-survive player over a 0%-to-survive one of equal value.</p>
            <div class="cluster dc-formula__actions">
              <button class="btn btn--soft btn--sm" type="button" data-dialog-open="knobs"><Icon name="layers" size={15} /> Strategy knobs and presets</button>
              <button class="btn btn--soft btn--sm" type="button" data-dialog-open="guide"><Icon name="book" size={15} /> What it learned from the guide</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. Interactive: ADP consumption curves -->
    <section class="section section--bordered" id="adp">
      <div class="container">
        <SectionHead num="03" eyebrow="Interactive" title="Where each position goes" lead="The market baseline behind every value and reach flag: how deep into each position a 12-team room usually is by a given pick. Drag the slider to read the curve. Click a position to switch." />
        <div class="dc-adp reveal" id="adp-demo" data-pos="RB" data-superflex="false" style={`--c:${SERIES_COLOR.RB}`}>
          <div class="dc-adp__controls">
            <div class="dc-adp__pos" role="group" aria-label="Position">
              {POSITIONS.map((pos) => (
                <button class="dc-pos" type="button" data-pos={pos} aria-pressed={pos === 'RB' ? 'true' : 'false'} style={`--sc:${SERIES_COLOR[pos]}`} title={POS_NAME[pos]}>
                  <span class="dc-pos__swatch" aria-hidden="true"></span>{pos}
                </button>
              ))}
            </div>
            <label class="dc-switch">
              <input type="checkbox" id="adp-superflex" />
              <span class="dc-switch__track" aria-hidden="true"></span>
              <span>Superflex league: QBs pulled forward</span>
            </label>
          </div>
          <div class="dc-adp__body">
            <div class="chart-card dc-adp__chart">
              <div class="chart-card__head">
                <span class="chart-card__title">ADP consumption curves</span>
                <span class="chart-card__note">12-team league · prior anchors from ffbot/adp.py</span>
              </div>
              <div id="adp-chart" set:html={initialChart}></div>
            </div>
            <aside class="dc-adp__read card card--sunk" aria-live="polite">
              <span class="eyebrow eyebrow--plain">Read the curve</span>
              <div class="dc-adp__big"><span id="adp-r-pos">RB</span><span id="adp-r-rank">18</span></div>
              <p class="dc-adp__line">is usually gone by <b id="adp-r-pick">pick 32</b></p>
              <p class="dc-adp__round" id="adp-r-round">Round 3, pick 8 in a 12-team league</p>
              <label class="dc-adp__lbl" for="adp-rank"><span>Positional rank</span><output id="adp-rank-out" for="adp-rank">18</output></label>
              <input class="dc-range" type="range" id="adp-rank" min="1" max={MAX_RANK.RB} value="18" step="1" aria-valuetext="RB18, pick 32" />
              <p class="dc-adp__note" id="adp-r-note">RB18 is one of the curve's anchors, so this value is stated, not interpolated.</p>
            </aside>
          </div>
          <details class="dc-anchors">
            <summary><Icon name="table" size={16} /> Show the anchor table</summary>
            <div class="table-wrap">
              <table class="table dc-anchors__table">
                <caption class="sr-only">Prior ADP anchors: positional rank and the overall pick it maps to, for a 12-team league</caption>
                <thead><tr><th scope="col">Position</th><th scope="col">Anchors (positional rank → overall pick)</th></tr></thead>
                <tbody>
                  {POSITIONS.map((pos) => (
                    <tr><th scope="row">{pos}</th><td class="dc-anchors__cells">{draft.anchors[pos].map(([r, pk]) => <span class="chip">{pos}{r} → {pk}</span>)}</td></tr>
                  ))}
                  <tr><th scope="row">QB, superflex</th><td class="dc-anchors__cells">{draft.superflexQb.map(([r, pk]) => <span class="chip">QB{r} → {pk}</span>)}</td></tr>
                </tbody>
              </table>
            </div>
            <p class="small muted">Picks beyond {LAST_PICK} fall after the last round of a 15-round draft. QB and TE anchors are pinned to landmarks stated on the guide's strategy page; a superflex league swaps in the superflex QB anchors, and learned anchors replace these priors once a league shape has been observed enough times.</p>
          </details>
        </div>
      </div>
