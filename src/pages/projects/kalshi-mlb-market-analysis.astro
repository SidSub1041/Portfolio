---
/**
 * Kalshi MLB Market Analysis tab. Trading-terminal design: near-black navy, thin price grid,
 * green/red price colours, mono numerals, a baseball-diamond line drawing in the hero.
 * Every number comes from src/data/kalshi.json (the repository's data/ and REPORT.md) or
 * from the repository files named in DESIGN.md section 6.
 */
import Base from '../../layouts/Base.astro';
import CaseMeta from '../../components/CaseMeta.astro';
import CaseTrio from '../../components/CaseTrio.astro';
import Icon from '../../components/Icon.astro';
import Dialog from '../../components/Dialog.astro';
import SectionHead from '../../components/SectionHead.astro';
import Stat from '../../components/Stat.astro';
import Diamond from '../../components/kalshi/Diamond.astro';
import GameTape from '../../components/kalshi/GameTape.astro';
import { lineChart, barChart, scatterChart, sparkline } from '../../lib/chart';
import { eventLabel, fmtInt } from '../../lib/format';
import { heroPathChart, drawable, tagInOrder, cents, signed, times, round } from '../../components/kalshi/charts';
import { projects, projectById } from '../../data/projects';
import { url } from '../../site.config';
import K from '../../data/kalshi.json';

const p = projectById.kalshi;
const others = projects.filter((x) => x.id !== 'kalshi');
const snapshotDate = K.snapshotAt.slice(0, 10);

/* ---- Hero: one real moneyline path --------------------------------------- */
const game = K.games.find((g) => g.code === K.gamePath.code) ?? K.games[0];
const series = K.gamePath.series;
const plays = K.gamePath.scoringPlays;
const openP = series[0].p, closeP = series[series.length - 1].p;
const heroAria = `${K.gamePath.side} moneyline yes price in cents by minute, ${K.gamePath.label}: ${openP} cents when the market window opened, ${closeP} at the close, with ${plays.length} scoring plays marked`;
const heroDesktop = heroPathChart({ id: 'kx-hero-d', width: 1100, height: 380, series, plays, ariaLabel: heroAria });
const heroPhone = heroPathChart({ id: 'kx-hero-m', width: 390, height: 300, fontSize: 12, pad: { t: 50, r: 50, b: 34, l: 10 }, series, plays, ariaLabel: heroAria });
const heroData = JSON.stringify({ series, plays, side: K.gamePath.side, away: game.away, home: game.home });
const playRows = plays.map((s, i) => {
  const [a, h] = s.score.split('-');
  return { n: i + 1, when: `${s.half === 'top' ? 'T' : 'B'}${s.inning}`, event: s.event, rbi: s.rbi, score: `${game.away} ${a}, ${game.home} ${h}`, home: s.half === 'bottom', m: s.m };
});
// Final scores from data/plays_<game>.csv in the repository (last row, away_score and home_score).
const finals: Record<string, { away: number; home: number }> = {
  DETNYY: { away: 9, home: 3 }, PITPHI: { away: 0, home: 8 }, TBKC: { away: 10, home: 4 },
  MINHOU: { away: 4, home: 6 }, SDCHC: { away: 7, home: 9 }, LAASEA: { away: 3, home: 8 },
};

/* ---- Section 1: how prices react ----------------------------------------- */
type SummaryRow = (typeof K.summary)[number];
const order = ['home_run', 'scoring_play', 'walk_hbp', 'single', 'xbh', 'strikeout', 'out_in_play'];
const byGroup = Object.fromEntries(K.summary.map((r) => [r.group, r])) as Record<string, SummaryRow>;
const rows = order.map((g) => byGroup[g]).filter(Boolean);
// The volume column is the median ratio per event type (analyze.py). REPORT.md gives 4.4× for any
// scoring play on that definition, so that row is quoted from the report.
const volSpike = (r: SummaryRow): number => (r.group === 'scoring_play' ? 4.4 : r.volRatio);
const pText = (v: number | null): string => (v == null ? 'n/a' : v < 0.001 ? '<0.001' : v.toFixed(3));
const shortLabel: Record<string, string> = { home_run: 'Home run', scoring_play: 'Scoring play', walk_hbp: 'Walk/HBP', single: 'Single', xbh: 'Double/triple', strikeout: 'Strikeout', out_in_play: 'Out in play' };
const immVals = rows.map((r) => r.imm), driftVals = rows.map((r) => r.drift);
const immColors = immVals.map((v) => (v >= 0 ? 'var(--pos)' : 'var(--neg)'));
const tagNegBars = (svg: string, nSer: number, vals: number[][]) => tagInOrder(svg, '<rect class="ch-bar"', (i) => (vals[i % nSer][Math.floor(i / nSer)] < 0 ? 'data-neg="1"' : ''));
const reactBarsAria = 'Mean immediate and drift reaction in cents by event type: home run, scoring play, walk or HBP, single, double or triple, strikeout, out in play';
const reactBarsD = tagNegBars(drawable(barChart({
  width: 760, height: 330, categories: rows.map((r) => shortLabel[r.group]),
  series: [{ values: immVals, color: immColors, label: 'Immediate' }, { values: driftVals, color: 'color-mix(in srgb, var(--hl) 82%, transparent)', label: 'Drift' }],
  valueFmt: (v) => signed(v, 1), ariaLabel: reactBarsAria, fontSize: 11, gap: 0.34,
})), 2, [immVals, driftVals]);
const reactBarsM = tagNegBars(drawable(barChart({
  width: 390, height: 460, horizontal: true, pad: { l: 100, r: 52 }, categories: rows.map((r) => shortLabel[r.group]),
  series: [{ values: immVals, color: immColors }, { values: driftVals, color: 'color-mix(in srgb, var(--hl) 82%, transparent)' }],
  valueFmt: (v) => signed(v, 1), ariaLabel: reactBarsAria, fontSize: 12, gap: 0.3,
})), 2, [immVals, driftVals]);

/* ---- Section 2: reaction path -------------------------------------------- */
const rpKeys = ['home_run', 'scoring_play', 'single', 'walk_hbp', 'strikeout', 'out_in_play'];
const rpColors: Record<string, string> = {
  home_run: 'var(--accent)', scoring_play: 'var(--hl)',
  single: 'color-mix(in srgb, var(--accent) 42%, var(--fg))', walk_hbp: 'color-mix(in srgb, var(--hl) 42%, var(--fg))',
  strikeout: 'var(--neg)', out_in_play: 'color-mix(in srgb, var(--neg) 50%, var(--fg-3))',
};
const rpSeriesData = K.reactionPath.series as Record<string, { n: number; mean: number[] }>;
const minutes = K.reactionPath.minutes;
const rpSeries = rpKeys.map((k) => ({ key: k, n: rpSeriesData[k].n, color: rpColors[k], points: minutes.map((m, i) => ({ x: m, y: rpSeriesData[k].mean[i] })) }));
const minuteFmt = (v: number) => (v > 0 ? `+${v}` : v < 0 ? `−${Math.abs(v)}` : '0');
const rpAria = 'Average price path in cents from three minutes before to eight minutes after a play, for home runs, scoring plays, singles, walks, strikeouts and outs in play';
const reactionPath = (w: number, h: number, fs: number, pad: { t?: number; r?: number; b?: number; l?: number }) =>
  tagInOrder(tagInOrder(drawable(lineChart({
    width: w, height: h, fontSize: fs, pad,
    series: rpSeries.map((s) => ({ points: s.points, color: s.color, width: s.key === 'home_run' || s.key === 'scoring_play' ? 2.6 : 1.8, dots: true })),
    zeroLine: true, xTicks: 12, xFmt: minuteFmt, yFmt: (v) => `${signed(v, 0)}¢`,
    markers: [{ x: 0, label: 'play ends', color: 'var(--fg-3)' }, { x: 2, label: 'drift window', color: 'var(--fg-3)' }, { x: 7, color: 'var(--fg-3)' }],
    ariaLabel: rpAria,
  })), '<path class="ch-line"', (i) => `data-series="${rpKeys[i]}"`), '<circle class="ch-dot"', (i) => `data-series="${rpKeys[Math.floor(i / minutes.length)]}"`);
const reactionPathD = reactionPath(760, 360, 11, { r: 22, l: 50 });
const reactionPathM = reactionPath(390, 300, 12, { r: 14, l: 44, b: 32 });
const hrPath = rpSeriesData.home_run.mean, scPath = rpSeriesData.scoring_play.mean;
const at = (arr: number[], minute: number) => arr[minutes.indexOf(minute)];

/* ---- Section 3: momentum ------------------------------------------------- */
const mo = K.momentum.points;
const scoringN = mo.filter((q) => q.scoring).length;
const moPts = mo.map((q) => ({ x: q.imm, y: q.drift, color: q.scoring ? 'var(--accent)' : 'color-mix(in srgb, var(--fg-2) 60%, transparent)', r: q.scoring ? 4.6 : 3.4 }));
const moAria = `Scatter of ${mo.length} events with an immediate move of at least 3 cents: immediate move against the drift that followed, with a trend line sloping upward`;
const momentumScatter = (w: number, h: number, fs: number) => tagInOrder(drawable(scatterChart({
  width: w, height: h, fontSize: fs, points: moPts, trend: true, trendColor: 'var(--hl)', quadrants: true,
  xLabel: 'Immediate move, minutes 0 to 2 (¢)', yLabel: 'Drift, minutes 2 to 7 (¢)', xFmt: (v) => signed(v, 0), yFmt: (v) => signed(v, 0), ariaLabel: moAria,
})), '<circle class="ch-pt"', (i) => `data-scoring="${mo[i].scoring ? 1 : 0}" data-imm="${mo[i].imm}" data-drift="${mo[i].drift}"`);
const momentumD = momentumScatter(720, 400, 11);
const momentumM = momentumScatter(390, 330, 12);
const asym = K.asymmetry;

/* ---- Section 4: speed and leverage --------------------------------------- */
const innings = K.byInning;
const innMax = Math.max(...innings.map((b) => b.meanAbsImm));
const hrSpark = drawable(sparkline(minutes.map((m, i) => ({ x: m, y: hrPath[i] })), { width: 220, height: 64, color: 'var(--accent)', area: true, zero: true, ariaLabel: 'Average home-run price path from minute −3 to +8' }));
const liq = K.liquidity;

/* ---- Pipeline facts (README.md, crate sources, deploy/README.md) ---------- */
const flow = [
  { kind: 'Sources', nodes: [
    { name: 'Kalshi REST and WebSocket', text: '1-minute candles, the raw trade tape, order books and fills for KXMLBGAME and KXMLBTOTAL markets.' },
    { name: 'MLB Stats API (GUMBO)', text: 'Play-by-play with pitch-level decisive timestamps and base-out state.' },
  ] },
  { kind: 'collector crate', nodes: [{ name: 'Season-scale collection', text: 'Async, about 8 requests per second under the public limit of about 10, resumable (existing files are skipped). 882 games and 66k+ events.' }] },
  { kind: 'common crate', nodes: [{ name: 'Shared clients and the win-probability engine', text: 'Auth signing, read-only portfolio reads, RE24 run expectancy plus season team ratings with logistic calibration, unit-tested against the Python reference, and the risk layer.' }] },
  { kind: 'paper-trader crate', nodes: [{ name: 'Autonomous paper trading', text: 'Fair values on every play, EV-gated maker entries, queue-accurate fill simulation, fee-aware exits, adaptive thresholds, layered risk controls.' }] },
  { kind: 'Operations', nodes: [
    { name: 'tracker_server.py on :8787', text: 'Self-refreshing dashboard: Today, 1W, 1M, YTD and All tabs, per-day attribution, open positions, polled every 5 s.' },
    { name: 'launchd agents', text: 'Trader and tracker run from an isolated live clone on a live-execution branch; deploy_once.sh swaps in a freshly built binary.' },
  ] },
];
---
<Base title="Kalshi MLB Market Analysis · Sid Subramanian" description={`${p.oneLiner} An event study of ${fmtInt(K.pilot.events)} plate-appearance events across ${K.pilot.games} games, and a Rust collector and paper trader built on what it found.`} theme="kalshi">
  <div class="kx">
    <div class="container">
      <div class="proj-bar">
        <div class="row"><span class="badge badge--soft">{p.period}</span><span class="muted">{p.status}</span></div>
        <div class="cluster" style="--cluster:6px">{p.stack.map((s) => <span class="chip chip--outline">{s}</span>)}</div>
        <div class="proj-bar__links">
          {p.links.map((l) => <a class="btn btn--ghost btn--sm" href={l.url}><Icon name={l.kind === 'repo' ? 'github' : 'book'} size={14} /> {l.label}</a>)}
        </div>
      </div>
    </div>

    <CaseMeta project={p} index={2} />

    <!-- 1. Hero -->
    <section class="hero kx-hero grain" aria-labelledby="kx-title">
      <div class="hero__bg kx-hero__bg" aria-hidden="true">
        <div class="kx-hero__grid"></div>
        <div class="kx-hero__diamond draw" data-parallax="0.08"><Diamond /></div>
      </div>
      <div class="container">
        <div class="kx-hero__top">
          <span class="kicker reveal"><span class="dot"></span> Event study · Rust paper trader · {p.period}</span>
          <h1 id="kx-title" class="reveal" style="--i:1">Kalshi MLB Market Analysis</h1>
          <p class="lead reveal" style="--i:2">{p.oneLiner}</p>
          <p class="kx-hero__sub reveal" style="--i:3">A pilot study on the June 30 2026 slate measured how moneyline and totals prices moved around every plate appearance. The finding was momentum, not overreaction. That became the thesis for a Rust collector and paper trader that ran across the season.</p>
          <div class="kx-tiles reveal" style="--i:4">
            <div class="kx-tile"><span class="kx-tile__label">Games in the pilot</span><span class="kx-tile__value" data-count={K.pilot.games} data-format="int">{K.pilot.games}</span><span class="kx-tile__sub">Jun 30 2026, 1-minute candles</span></div>
            <div class="kx-tile"><span class="kx-tile__label">Plate-appearance events</span><span class="kx-tile__value" data-count={K.pilot.events} data-format="int">{K.pilot.events}</span><span class="kx-tile__sub">{K.pilot.scoringEvents} of them scoring plays</span></div>
            <div class="kx-tile"><span class="kx-tile__label">Games collected</span><span class="kx-tile__value" data-count={882} data-format="int">882</span><span class="kx-tile__sub">full season, Rust collector</span></div>
            <div class="kx-tile"><span class="kx-tile__label">Events collected</span><span class="kx-tile__value"><span data-count={66000} data-format="k">66k</span>+</span><span class="kx-tile__sub">candles, trades, play-by-play</span></div>
          </div>
          <div class="hero__actions reveal" style="--i:5">
            {p.links.map((l, i) => <a class:list={['btn', i === 0 ? 'btn--primary' : 'btn--ghost']} href={l.url}><Icon name={l.kind === 'repo' ? 'github' : 'book'} size={16} /> {l.label}</a>)}
            <button class="btn btn--soft" type="button" data-dialog-open="kx-method"><Icon name="info" size={16} /> How the study was built</button>
          </div>
        </div>

        <div class="kx-panel reveal reveal--scale" style="--i:3" id="kx-hero-chart">
          <div class="kx-panel__head">
            <div class="kx-panel__id">
              <span class="kx-ticker">{K.gamePath.ticker}</span>
              <span class="kx-panel__label">{K.gamePath.label} · {K.gamePath.side} to win, yes price</span>
            </div>
            <p class="kx-readout" id="kx-readout" aria-live="polite"><span class="kx-readout__k">opened</span> <b>{openP}¢</b> <span class="kx-readout__sep">·</span> <span class="kx-readout__k">settled</span> <b class="kx-pos">{closeP}¢ yes</b> <span class="kx-readout__hint">Hover or touch the chart to read any minute</span></p>
          </div>
          <div class="kx-panel__body draw">
            <div class="kx-ch kx-ch--d" set:html={heroDesktop} />
            <div class="kx-ch kx-ch--m" set:html={heroPhone} />
          </div>
          <div class="kx-plays" aria-label="Scoring plays in the game">
            {playRows.map((r) => <span class="kx-play" style={`--c:${r.home ? 'var(--pos)' : 'var(--neg)'}`}><span class="kx-play__n">{r.n}</span><span class="kx-play__when">{r.when}</span><span>{r.event}, {r.rbi} RBI</span><span class="kx-play__score">{r.score}</span></span>)}
          </div>
          <script type="application/json" id="kx-hero-data" set:html={heroData} />
        </div>
      </div>
      <GameTape games={K.games} finals={finals} />
    </section>

    <CaseTrio project={p} />

    <!-- 2. How prices react -->
    <section class="section kx-sec" id="reactions">
      <div class="container">
        <SectionHead num="01" eyebrow="Event study" title="How prices react to a plate appearance" lead="Every one of the 455 plate appearances in the six games was lined up with its game's one-minute candles. Signs follow the batting team: positive means the price moved toward the team at bat." />
        <div class="table-wrap reveal">
          <table class="table kx-table">
            <thead><tr><th>Event</th><th class="num">n</th><th class="num">Immediate, 0 to 2 min</th><th class="num">Drift, 2 to 7 min</th><th class="num">Volume spike</th><th class="num">Totals market, immediate</th><th class="num">p</th></tr></thead>
            <tbody>
              {rows.map((r) => (
                <tr class:list={{ 'kx-table__hl': r.group === 'scoring_play' }}>
                  <td><span class="kx-evlabel"><span class="kx-evdot" style={`--c:${r.imm >= 0 ? 'var(--pos)' : 'var(--neg)'}`}></span>{eventLabel(r.group)}</span></td>
                  <td class="num">{r.n}</td>
                  <td class:list={['num', r.imm >= 0 ? 'kx-pos' : 'kx-neg']}>{cents(r.imm, 2)}</td>
                  <td class:list={['num', r.drift > 0 ? 'kx-pos' : r.drift < 0 ? 'kx-neg' : '']}>{cents(r.drift, 2)}</td>
                  <td class="num">{times(volSpike(r))}</td>
                  <td class:list={['num', r.totImm >= 0 ? 'kx-pos' : 'kx-neg']}>{cents(r.totImm, 2)}</td>
                  <td class="num muted">{pText(r.immP)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="small muted kx-foot reveal">Cents, moneyline market, batting team's perspective. Volume spike is the median ratio of the three-minute volume after a play to the game's baseline; the scoring-play row is quoted from REPORT.md. p is a one-sample t-test of the immediate move against zero. Totals column: change in the over price.</p>

        <div class="kx-split">
          <div class="chart-card draw reveal kx-bars-anim" style="--i:1">
            <div class="chart-card__head"><span class="chart-card__title">Immediate reaction and the drift that followed</span><span class="chart-card__note">mean cents · n = 455 events</span></div>
            <div class="kx-ch kx-ch--d" set:html={reactBarsD} />
            <div class="kx-ch kx-ch--m kx-bars-anim--h" set:html={reactBarsM} />
            <div class="legend" style="margin-top:12px"><span class="legend__item"><span class="legend__swatch" style="--c:var(--pos)"></span>Immediate, positive</span><span class="legend__item"><span class="legend__swatch" style="--c:var(--neg)"></span>Immediate, negative</span><span class="legend__item"><span class="legend__swatch" style="--c:var(--hl)"></span>Drift, 2 to 7 min</span></div>
          </div>
          <div class="stack kx-notes" style="--stack:12px">
            <div class="card card--sunk kx-note reveal" style="--i:2"><Icon name="trending-up" /><div><b>Totals react even harder.</b><p>A scoring play moves the over about +12¢ immediately, and every out applies steady scoreless pressure of about −2¢.</p></div></div>
            <div class="card card--sunk kx-note reveal" style="--i:3"><Icon name="bolt" /><div><b>Outs are priced instantly.</b><p>A strikeout or an out in play costs the batting team about 1.5¢ at once and then nothing more: drift after an out is close to zero.</p></div></div>
            <div class="card card--sunk kx-note reveal" style="--i:4"><Icon name="trending-down" /><div><b>Rallies keep going.</b><p>Home runs, walks and singles all show positive drift after the immediate move. The one exception, doubles and triples, has ten events and a p-value of 0.088.</p></div></div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. Reaction path -->
    <section class="section section--bordered kx-sec kx-sec--sunk" id="path">
      <div class="container">
        <SectionHead num="02" eyebrow="Minute by minute" title="The reaction path" lead="The average price path around each kind of play, from three minutes before to eight minutes after. Minute 0 is the first candle boundary after the play ends. The baseline is the candle two minutes earlier, so every path passes through zero at −2." />
        <div class="chart-card reveal" id="kx-reaction">
          <div class="chart-card__head">
            <span class="chart-card__title">Average change in the batting team's price</span>
            <span class="chart-card__note">cents · click a series to isolate it</span>
          </div>
          <div class="kx-legend" role="group" aria-label="Series">
            {rpSeries.map((s) => <button class="kx-legend__chip" type="button" data-series-toggle={s.key} aria-pressed="true" style={`--c:${s.color}`}><span class="kx-legend__swatch"></span>{eventLabel(s.key)} <span class="kx-legend__n">n={s.n}</span></button>)}
            <button class="kx-legend__reset" type="button" data-series-reset hidden>Show all</button>
          </div>
          <div class="draw">
            <div class="kx-ch kx-ch--d" set:html={reactionPathD} />
            <div class="kx-ch kx-ch--m" set:html={reactionPathM} />
          </div>
        </div>
        <div class="grid grid--3 kx-path-notes">
          <div class="reveal" style="--i:1"><span class="kx-kv__k">Home run</span><p><b class="mono kx-pos">{cents(at(hrPath, 0))}</b> at minute 0, <b class="mono kx-pos">{cents(at(hrPath, 8))}</b> by minute +8. The step happens in the same minute as the play.</p></div>
          <div class="reveal" style="--i:2"><span class="kx-kv__k">Any scoring play</span><p><b class="mono kx-pos">{cents(at(scPath, 2))}</b> two minutes after the play, <b class="mono kx-pos">{cents(at(scPath, 8))}</b> at eight. The move keeps extending after the first two minutes.</p></div>
          <div class="reveal" style="--i:3"><span class="kx-kv__k">Strikeout and out in play</span><p>About <b class="mono kx-neg">{cents(at(rpSeriesData.strikeout.mean, 2))}</b> and <b class="mono kx-neg">{cents(at(rpSeriesData.out_in_play.mean, 2))}</b> at minute +2, then a flat line: the bad news is fully priced on arrival.</p></div>
        </div>
      </div>
    </section>

    <!-- 4. Momentum, not overreaction -->
    <section class="section section--bordered kx-sec" id="momentum">
      <div class="container">
        <SectionHead num="03" eyebrow="The finding" title="Momentum, not overreaction" lead="The classic trade in a market that jumps on news is to fade the jump. Here that trade loses. On the big moves, the immediate reaction and the drift after it point the same way." />
        <div class="kx-split kx-split--mo" id="kx-momentum">
          <div class="chart-card kx-tip-host reveal" style="--i:1">
            <div class="chart-card__head">
              <span class="chart-card__title">Immediate move against the drift that followed</span>
              <button class="kx-toggle" type="button" data-hl-toggle aria-pressed="false"><span class="kx-toggle__dot"></span>Highlight scoring plays</button>
            </div>
            <div class="kx-mo draw">
              <div class="kx-ch kx-ch--d" set:html={momentumD} />
              <div class="kx-ch kx-ch--m" set:html={momentumM} />
            </div>
            <div class="kx-tip mono" hidden></div>
            <div class="legend" style="margin-top:10px"><span class="legend__item"><span class="legend__swatch legend__swatch--dot" style="--c:var(--accent)"></span>Scoring play ({scoringN})</span><span class="legend__item"><span class="legend__swatch legend__swatch--dot" style="--c:var(--fg-3)"></span>Other event ({mo.length - scoringN})</span><span class="legend__item"><span class="legend__swatch" style="--c:var(--hl)"></span>Least-squares trend</span></div>
          </div>
          <div class="stack" style="--stack:20px">
            <div class="stat-row kx-stat-row reveal" style="--i:2">
              <Stat label="Pearson ρ" value={K.momentum.rho.toFixed(3)} count={K.momentum.rho} format="dec3" tone="accent" sub="immediate vs drift" />
              <Stat label="p-value" value={K.momentum.p.toFixed(3)} count={K.momentum.p} format="dec3" sub="two-sided" />
              <Stat label="Big moves" value={String(K.momentum.n)} count={K.momentum.n} format="int" sub="|immediate| ≥ 3¢" />
            </div>
            <div class="kx-bars reveal" style="--i:3" aria-label="Gross result per event of riding or fading a big move">
              <span class="kx-bars__title">Per event, gross, cents</span>
              <div class="kx-bar kx-bar--div"><span class="kx-bar__label">Ride the move</span><span class="kx-bar__track"><span class="kx-bar__fill is-pos" style={`--w:${(K.momentum.rideCents / 1.2) * 50}%`}></span></span><span class="kx-bar__val mono kx-pos">{cents(K.momentum.rideCents, 2)}</span></div>
              <div class="kx-bar kx-bar--div"><span class="kx-bar__label">Fade the move</span><span class="kx-bar__track"><span class="kx-bar__fill is-neg" style={`--w:${(Math.abs(K.momentum.fadeCents) / 1.2) * 50}%`}></span></span><span class="kx-bar__val mono kx-neg">{cents(K.momentum.fadeCents, 2)}</span></div>
              <p class="small muted">Riding keeps +0.37¢ per event after half the spread.</p>
            </div>
            <div class="kx-bars reveal" style="--i:4" aria-label="Average drift after an up move and after a down move">
              <span class="kx-bars__title">Average drift after the immediate move</span>
              <div class="kx-bar"><span class="kx-bar__label">After an up move <small>n = {asym.nUp}</small></span><span class="kx-bar__track"><span class="kx-bar__fill is-pos" style="--w:100%"></span></span><span class="kx-bar__val mono kx-pos">{cents(asym.afterUp, 2)}</span></div>
              <div class="kx-bar"><span class="kx-bar__label">After a down move <small>n = {asym.nDown}</small></span><span class="kx-bar__track"><span class="kx-bar__fill is-flat" style={`--w:${(asym.afterDown / asym.afterUp) * 100}%`}></span></span><span class="kx-bar__val mono muted">{cents(asym.afterDown, 2)}</span></div>
              <p class="small muted">Good news continues; bad news is already in the price.</p>
            </div>
          </div>
        </div>
        <div class="callout kx-callout reveal" style="--i:5">
          <Icon name="target" />
          <p><b>The cleanest entry the pilot found:</b> buy the batting team, or the over, in the first minute or two after a scoring play. On average the position gained another 2 to 3¢ over the next five to six minutes. Whether that survives fees and fills is the question the pipeline below was built to answer.</p>
        </div>
      </div>
    </section>

    <!-- 5. Speed and leverage -->
    <section class="section section--bordered kx-sec kx-sec--sunk" id="speed">
      <div class="container">
        <SectionHead num="04" eyebrow="Speed and leverage" title="A narrow window, and a deep enough book" lead="The reaction is fast, strongest early in the game, and happens in a market that is liquid enough to trade at a one-cent spread." />
        <div class="grid grid--3 kx-speed">
          <div class="card reveal" style="--i:1">
            <span class="kx-kv__k">Reaction speed</span>
            <div class="kx-big"><span class="mono" data-count={87} data-format="pct">87%</span></div>
            <p class="kx-big__sub">of a home run's seven-minute move is complete within two minutes (the median event). Much of it lands in the same minute as the play.</p>
            <div class="kx-spark draw" set:html={hrSpark} />
            <p class="small muted">Average home-run path, −3 to +8 min. A live strategy has to act in seconds, from pitch-level feeds rather than minute candles.</p>
          </div>
          <div class="card reveal" style="--i:2">
            <span class="kx-kv__k">Leverage by inning</span>
            <div class="kx-bars kx-bars--tight reveal" style="--i:3" aria-label="Mean absolute immediate reaction by inning bucket">
              <span class="kx-bars__title">Mean |immediate| reaction</span>
              {innings.map((b, i) => <div class="kx-bar"><span class="kx-bar__label">Innings {b.bucket} <small>n = {b.n}</small></span><span class="kx-bar__track"><span class:list={['kx-bar__fill', i === 0 ? 'is-pos' : i === 1 ? 'is-mid' : 'is-flat']} style={`--w:${(b.meanAbsImm / innMax) * 100}%`}></span></span><span class="kx-bar__val mono">{round(b.meanAbsImm, 1).toFixed(1)}¢</span></div>)}
            </div>
            <p class="kx-big__sub">Early innings move prices most. By the seventh many prices are already near 0 or 100¢ and a single play changes little.</p>
          </div>
          <div class="card reveal" style="--i:3">
            <span class="kx-kv__k">Liquidity at event time</span>
            <dl class="kv kx-kv">
              <dt>Median spread</dt><dd class="mono">{round(liq.medianSpread, 0)}¢</dd>
              <dt>Median 3-min volume</dt><dd class="mono">${fmtInt(Math.round(liq.medianVol3min))}</dd>
              <dt>vs game baseline</dt><dd class="mono">{times(liq.medianVolRatio)}</dd>
            </dl>
            <p class="kx-big__sub">Volume roughly doubles around a play and the book stays tight, so the edge is not an artefact of an empty market. It is small, though, which is why fees decide everything.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. Caveats -->
    <section class="section section--bordered kx-sec" id="caveats">
      <div class="container">
        <SectionHead num="05" eyebrow="Caveats" title="What the pilot cannot tell you" lead="REPORT.md lists its own limits before its next steps. They are the reason the project did not stop at the finding." />
        <div class="grid grid--2 kx-caveats">
          <div class="card kx-caveat reveal" style="--i:1"><Icon name="calendar" /><div><b>One slate.</b><p>One day and six games. The result needed the full-season pass before anyone should trust it, which is what the collector was built to provide.</p></div></div>
          <div class="card kx-caveat reveal" style="--i:2"><Icon name="clock" /><div><b>Timestamps leak.</b><p>The MLB endTime stamp lags the decisive moment by 30 to 60 seconds (a home run is known before the play officially ends), so part of the reaction lands in the "pre" candle and the measured magnitudes understate the truth. One eighth-inning home run even sign-flipped.</p></div></div>
          <div class="card kx-caveat reveal" style="--i:3"><Icon name="layers" /><div><b>Windows overlap.</b><p>Plays arrive every two to three minutes, so a seven-minute drift window contains the next play. Drift estimates carry neighbour contamination.</p></div></div>
          <div class="card kx-caveat reveal" style="--i:4"><Icon name="shield" /><div><b>Fees eat the edge.</b><p>Kalshi taker fees are quadratic, about 1.75¢ at a 50¢ price, more than the +0.37¢ ride edge. Execution must be maker-side: resting limit orders, which carry no fee. That constraint shaped the whole paper trader.</p></div></div>
        </div>
      </div>
    </section>

    <!-- 7. From study to system -->
    <section class="section section--bordered kx-sec kx-sec--sunk" id="system">
      <div class="container">
        <SectionHead num="06" eyebrow="From study to system" title="A Rust workspace to collect the season and trade it on paper" lead="Three crates, about 2,300 lines of Rust, plus about 1,300 lines of Python for the research and the dashboard. The trader simulates fills against live order books and never places an order." />
        <div class="kx-flow" aria-label="Pipeline">
          {flow.map((row, ri) => (
            <>
              {ri > 0 && <div class="kx-flow__link reveal" style={`--i:${ri}`}><span></span></div>}
              <div class="kx-flow__row" style={`--cols:${row.nodes.length}`}>
                {row.nodes.map((nd, ni) => <div class="kx-node reveal" style={`--i:${ri + ni}`}><span class="kx-node__kind">{row.kind}</span><b>{nd.name}</b><p>{nd.text}</p></div>)}
              </div>
            </>
          ))}
        </div>

        <div class="grid grid--3 kx-features">
          <div class="feature reveal" style="--i:1"><Icon name="chart" /><h3>Win-probability engine</h3><p>Fair values from game state: RE24 base-out run expectancy, season team ratings and a logistic calibration layer. The Rust port is unit-tested against the Python reference in wp_model.py.</p></div>
          <div class="feature reveal" style="--i:2"><Icon name="database" /><h3>Maker entries, honest fills</h3><p>Entries are EV-gated resting orders so no taker fee is paid. A fill is credited only after the simulation tracks the displayed queue ahead of the order; exits are fee-aware and thresholds adapt.</p></div>
          <div class="feature reveal" style="--i:3"><Icon name="shield" /><h3>Layered risk controls</h3><p>Single-clip sizing, one side per game, salvage exits, per-market loss stops and feed-freshness guards in the trader; a pure risk module with hard caps for anything that would ever go live.</p><button class="btn btn--soft btn--sm" type="button" data-dialog-open="kx-risk"><Icon name="lock" size={14} /> Risk layer defaults</button></div>
          <div class="feature reveal" style="--i:4"><Icon name="refresh" /><h3>Backtest and training</h3><p>wp_model.py backtests model-versus-market gaps across the 882 collected games, net of fees. train.py fits HistGradientBoosting to post-event drift over 1, 3, 5 and 10-minute horizons with weekly walk-forward validation.</p></div>
          <div class="feature reveal" style="--i:5"><Icon name="cpu" /><h3>Runs itself</h3><p>launchd agents run the trader and the tracker from an isolated clone on a live-execution branch, so a build or branch switch in the dev tree can never yank the running binary out from under it.</p></div>
          <div class="feature reveal" style="--i:6"><Icon name="code" /><h3>Specified, not built: the executor</h3><p>Signing, read-only account views, fill parsing and the risk book exist and are tested. The layer that would send orders is a written contract, deliberately left to a human operator.</p><button class="btn btn--soft btn--sm" type="button" data-dialog-open="kx-exec"><Icon name="book" size={14} /> Live execution spec</button></div>
