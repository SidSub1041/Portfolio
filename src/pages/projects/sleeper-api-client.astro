---
/**
 * Sleeper API Java Client tab. Design: an engineering blueprint. Deep blue, a white
 * drafting grid, cyan ink, mono labels, bracketed section numbers, crop marks on cards.
 * Every number comes from src/data/sleeper.json or the Fantasy-Football-Draft-Assistant
 * repository (README.md, build.gradle, .circleci/config.yml, src/main/java).
 */
import Base from '../../layouts/Base.astro';
import CaseMeta from '../../components/CaseMeta.astro';
import CaseTrio from '../../components/CaseTrio.astro';
import Icon from '../../components/Icon.astro';
import Dialog from '../../components/Dialog.astro';
import SectionHead from '../../components/SectionHead.astro';
import Stat from '../../components/Stat.astro';
import Sheet from '../../components/sleeper/Sheet.astro';
import Schematic from '../../components/sleeper/Schematic.astro';
import CodeBlock from '../../components/sleeper/CodeBlock.astro';
import { endpoints, derivedHelpers, groupOrder, groupMeta, readmeExamples, build } from '../../components/sleeper/data';
import { java } from '../../components/sleeper/highlight';
import { projects, projectById } from '../../data/projects';
import { url } from '../../site.config';
import sleeper from '../../data/sleeper.json';

const p = projectById.sleeper;
const draft = projectById.draft;
const groups = sleeper.groups as Record<string, string[]>;
const files = sleeper.files;
const javaLines = sleeper.javaLines;
const testClasses = sleeper.tests;
const groupCount = Object.keys(groups).length;
const endpointCount = endpoints.length;
const maxFiles = Math.max(...Object.values(groups).map((g) => g.length));
const shortName = (s: string) => s.split('.').pop() ?? s;
const others = projects.filter((x) => x.id !== 'sleeper');
const repoLink = p.links.find((l) => l.kind === 'repo')!;
const docLinks = p.links.filter((l) => l.kind !== 'repo');
const groupId = (g: string) => `sl-group-${g.replace(/[()]/g, '') || 'root'}`;
const seasons = [2026, 2025, 2024, 2023];
const description = `${p.oneLiner} A fork of sdcalmes/sleeper-api: ${files} Java files and ${javaLines.toLocaleString('en-US')} lines across ${groupCount} package groups, ${endpointCount} wrapped endpoints, Gradle, JUnit and CircleCI, plus a live API explorer.`;
---
<Base title={`${p.name} — Sid Subramanian`} description={description} theme="sleeper">
  <div class="sl">
    <!-- Project bar -->
    <div class="container">
      <div class="proj-bar">
        <div class="row">
          <span class="mono muted">{p.period}</span>
          <span class="badge badge--soft">{p.status}</span>
          <span class="cluster" style="--cluster:6px">{p.stack.map((s) => <span class="chip chip--outline">{s}</span>)}</span>
        </div>
        <div class="proj-bar__links">
          {p.links.map((l) => <a class="btn btn--ghost btn--sm" href={l.url}><Icon name={l.kind === 'repo' ? 'github' : 'arrow-up-right'} size={15} /> {l.label}</a>)}
        </div>
      </div>
    </div>

    <CaseMeta project={p} index={4} />

    <!-- [00] Hero -->
    <section class="hero sl-hero grain" id="top">
      <div class="hero__bg sl-hero__bg" aria-hidden="true">
        <div class="sl-hero__glow" data-parallax="0.08"></div>
        <div class="sl-hero__glow sl-hero__glow--hl" data-parallax="0.05"></div>
        <svg class="sl-mark sl-mark--tl" viewBox="-12 -12 24 24"><circle r="6" /><path d="M-11 0h22M0 -11v22" /></svg>
        <svg class="sl-mark sl-mark--tr" viewBox="-12 -12 24 24"><circle r="6" /><path d="M-11 0h22M0 -11v22" /></svg>
        <svg class="sl-mark sl-mark--bl" viewBox="-12 -12 24 24"><circle r="6" /><path d="M-11 0h22M0 -11v22" /></svg>
        <svg class="sl-mark sl-mark--br" viewBox="-12 -12 24 24"><circle r="6" /><path d="M-11 0h22M0 -11v22" /></svg>
      </div>
      <div class="container">
        <div class="sl-hero__grid">
          <div>
            <span class="kicker reveal"><span class="dot"></span> Drawing 05 · Java library · {p.period}</span>
            <h1 class="reveal" style="--i:1">{p.name}</h1>
            <p class="lead reveal" style="--i:2">{p.oneLiner} Users, leagues, drafts, players and stats as plain Java objects. Built with Gradle, tested with JUnit on CircleCI.</p>
            <p class="sl-lineage reveal" style="--i:3"><Icon name="branch" size={18} /><span><b>Lineage:</b> a fork of sdcalmes/sleeper-api, extended toward a draft assistant.</span></p>
            <pre class="sl-typeline reveal" style="--i:3" aria-label="The README calls, typed out"><code id="sl-type"></code></pre>
            <div class="sl-dim reveal" style="--i:4"><span class="sl-dim__line"></span><span class="sl-dim__label"><b data-count={javaLines} data-format="int">{javaLines.toLocaleString('en-US')}</b> lines of Java · {files} files</span><span class="sl-dim__line"></span></div>
            <div class="hero__actions reveal" style="--i:5">
              <a class="btn btn--primary" href={repoLink.url}><Icon name="github" size={17} /> {repoLink.label}</a>
              {docLinks.map((l) => <a class="btn btn--ghost" href={l.url}>{l.label} <Icon name="arrow-up-right" class="arrow" size={16} /></a>)}
            </div>
            <div class="hero__meta reveal" style="--i:6">
              <span class="chip chip--accent">Java {build.java}</span>
              <span class="chip">Retrofit 2.6.0</span>
              <span class="chip">Gson 2.8.9</span>
              <span class="chip">JUnit 4.12</span>
              <span class="chip">CircleCI</span>
            </div>
          </div>
          <Sheet />
        </div>
      </div>
    </section>

    <CaseTrio project={p} />

    <!-- [01] Coverage -->
    <section class="section sl-section" data-num="[01]" id="coverage">
      <div class="container">
        <SectionHead num="01" eyebrow="Coverage" title="Eight package groups, one Retrofit client" lead="Each endpoint group is a Java package: an interface that declares the GET paths, an Impl class that runs the call and parses errors, and plain objects for the JSON." />
        <div class="stat-row sl-stats reveal">
          <Stat label="Lines of Java" value={javaLines.toLocaleString('en-US')} count={javaLines} format="int" sub="src/main/java only" />
          <Stat label="Source files" value={String(files)} count={files} format="int" sub={`${groupCount} package groups`} />
          <Stat label="Endpoints wrapped" value={String(endpointCount)} count={endpointCount} format="int" sub="GET paths in the interfaces" />
          <Stat label="JUnit test classes" value={String(testClasses.length)} count={testClasses.length} format="int" sub="run by CircleCI" />
        </div>
        <div class="sl-coverage-actions reveal" style="--i:1">
          <button type="button" class="btn btn--soft btn--sm" data-dialog-open="sl-endpoints"><Icon name="table" size={16} /> Endpoint reference</button>
          <button type="button" class="btn btn--ghost btn--sm" data-dialog-open="sl-index"><Icon name="layers" size={16} /> Package index, all {files} classes</button>
        </div>
        <div class="sl-groups">
          {groupOrder.map((g, i) => {
            const classes = groups[g];
            const meta = groupMeta[g];
            const shown = classes.slice(0, 6);
            return (
              <article class="card card--hover sl-card sl-group reveal" id={groupId(g)} style={`--i:${(i % 4) + 1}; --w:${Math.round((classes.length / maxFiles) * 100)}%`}>
                <div class="sl-group__top">
                  <span class="sl-group__name">[{meta.label}]</span>
                  <span class="sl-group__n"><b>{classes.length}</b> <small>{classes.length === 1 ? 'file' : 'files'}</small></span>
                </div>
                <span class="sl-group__ruler" aria-hidden="true"><i></i></span>
                <p class="sl-group__blurb">{meta.blurb}</p>
                <div class="sl-group__classes">
                  {shown.map((c) => <span class:list={['sl-group__cls', { 'sl-group__cls--fork': shortName(c) === 'footballDraft' }]}>{shortName(c)}</span>)}
                  {classes.length > shown.length && <button type="button" class="sl-group__cls sl-group__cls--more" data-dialog-open="sl-index">+{classes.length - shown.length} more</button>}
                </div>
              </article>
            );
          })}
        </div>
        <div class="callout sl-callout reveal" style="margin-top:28px">
          <Icon name="info" size={18} />
          <p><b>Upstream's own caveat, still in the README:</b> the adapter is "incomplete, does not error check, and most likely has some poor choices when it comes to architecture." This page does not pretend otherwise. The endpoint reference above lists exactly what is wrapped.</p>
        </div>
      </div>
    </section>

    <!-- [02] Code -->
    <section class="section sl-section sl-section--sunk sl-grid-bg" data-num="[02]" id="code">
      <div class="container">
        <SectionHead num="02" eyebrow="Usage" title="Five calls from the README" lead="The README documents the client in five lines. They are quoted as written. The yellow placeholders are the README's own. Each maps to one GET below." />
        <div class="sl-code-grid">
          {readmeExamples.map((ex, i) => (
            <CodeBlock class:list={['reveal', { 'sl-code--wide': ex.id === 'client' }]} label={ex.label} http={ex.http} code={ex.code} style={`--i:${i}`}>
              {ex.id === 'client' && <p class="sl-code__note">One object, every group behind it: <code>users()</code>, <code>leagues()</code>, <code>drafts()</code>, <code>players()</code>, <code>stats()</code>. The constructor wires a static Retrofit instance over an OkHttp client with a 2 MB disk cache.</p>}
              {ex.id === 'user' && <p class="sl-code__note">The first call everything else needs: it returns the <code>user_id</code> that the league and draft endpoints take.</p>}
              {ex.id === 'leagues' && <p class="sl-code__note">Season is a string in the Java signature, for example <code>"2026"</code>. Leagues come back with their settings, scoring and roster positions.</p>}
              {ex.id === 'drafts' && <p class="sl-code__note">Every draft the user took part in that season: type, status, rounds, teams, start time and the ids to fetch picks.</p>}
              {ex.id === 'players' && <div class="sl-code__note sl-code__note--warn"><b>Once a day, at most.</b> Sleeper asks that this call run sparingly: it exists to refresh player ids and the average response is 5 MB. The source actually returns <code>Map&lt;String, Player&gt;</code> keyed by player id; the README's <code>List</code> is a typo in upstream's docs.</div>}
            </CodeBlock>
          ))}
        </div>
      </div>
    </section>

    <!-- [03] Architecture -->
    <section class="section sl-section" data-num="[03]" id="architecture">
      <div class="container">
        <SectionHead num="03" eyebrow="Architecture" title="From request to object" lead="Every call takes the same path. A Retrofit interface declares the GET. The Impl runs it. Gson maps the JSON onto plain objects. Anything but a 2xx becomes a SleeperError with the status code and the URL." />
        <div class="sl-schem-frame draw reveal" aria-label="Architecture schematic">
          <span class="sl-schem-frame__tag">Fig. 3 · call path</span>
          <Schematic layout="wide" />
          <Schematic layout="tall" />
        </div>
        <div class="grid grid--3 sl-arch-notes">
          <div class="feature sl-card reveal" style="--i:1"><Icon name="cpu" /><h3>Static transport</h3><p>SleeperApi builds one Retrofit on <code>http://api.sleeper.app/</code> with Gson, over an OkHttp client that caches 2 MB on disk at <code>./cache</code>. Each group gets a thin Impl around <code>retrofit.create(...)</code>.</p></div>
          <div class="feature sl-card reveal" style="--i:2"><Icon name="shield" /><h3>One error type</h3><p>Every Impl checks <code>r.isSuccessful()</code>. On failure, <code>ErrorUtils.parseError</code> builds a <code>SleeperError</code> with the HTTP status, the message and the request URL, so a caller can log exactly which GET failed.</p></div>
          <div class="feature sl-card reveal" style="--i:3"><Icon name="database" /><h3>Static metadata</h3><p><code>Metadata</code> holds a shared client, fixes the NFL season at 18 weeks (the comment notes the 2021 change) and exposes the protected <code>states()</code> group through <code>getSportState(Sports.NFL)</code>.</p></div>
        </div>
      </div>
    </section>

    <!-- [04] Explorer -->
    <section class="section sl-section sl-section--sunk sl-grid-bg" data-num="[04]" id="explorer">
      <div class="container">
        <SectionHead num="04" eyebrow="Interactive" title="Call the API the way the client does" lead="Type a Sleeper username. The page makes the same three requests the README examples make, straight from your browser to api.sleeper.app, and shows the Java line for each step." />
        <div class="card sl-explorer reveal" id="sl-explorer" data-api="https://api.sleeper.app">
          <div class="sl-explorer__head">
            <span class="sl-explorer__title"><Icon name="globe" size={18} /> API explorer <span class="badge badge--soft">live · api.sleeper.app</span></span>
            <button type="button" class="btn btn--ghost btn--sm" data-dialog-open="sl-explorer-notes"><Icon name="info" size={16} /> How this works</button>
          </div>
          <form class="sl-explorer__form" id="sl-explorer-form" novalidate>
            <div class="field"><label for="sl-username">Sleeper username</label><input id="sl-username" name="username" type="text" autocomplete="off" autocapitalize="none" spellcheck="false" placeholder="username, not display name" maxlength="64" required /></div>
            <div class="field"><label for="sl-season">Season</label><select id="sl-season" name="season">{seasons.map((y) => <option value={String(y)} selected={y === 2026}>{y}</option>)}</select></div>
            <button class="btn btn--primary" type="submit" id="sl-run"><Icon name="play" size={16} /> Run the calls</button>
          </form>
          <p class="sl-explorer__status" id="sl-explorer-status" aria-live="polite">Nothing is stored, logged or proxied. Requests go from this page to api.sleeper.app over HTTPS.</p>
          <ol class="sl-trace" role="list">
            <li class="sl-step" id="sl-step-user" data-status="idle">
              <div class="sl-step__rail"><span class="sl-step__n">1</span></div>
              <div class="sl-step__body">
                <div class="sl-step__head"><span class="sl-step__title">users().getByUsername</span><span class="sl-step__pill" data-role="status">waiting</span><span class="sl-step__ms" data-role="ms"></span></div>
                <pre class="sl-step__java"><code data-role="java" set:html={java('User user = sleeper.users().getByUsername({username});')}></code></pre>
                <p class="sl-step__http" data-role="http">GET https://api.sleeper.app/v1/user/{'{username}'}</p>
                <div class="sl-step__out" data-role="out"></div>
              </div>
            </li>
            <li class="sl-step" id="sl-step-leagues" data-status="idle">
              <div class="sl-step__rail"><span class="sl-step__n">2</span></div>
              <div class="sl-step__body">
                <div class="sl-step__head"><span class="sl-step__title">leagues().getAllLeaguesForUserBySeason</span><span class="sl-step__pill" data-role="status">waiting</span><span class="sl-step__ms" data-role="ms"></span></div>
                <pre class="sl-step__java"><code data-role="java" set:html={java('List<League> leagues = sleeper.leagues().getAllLeaguesForUserBySeason({user_id}, {season});')}></code></pre>
                <p class="sl-step__http" data-role="http">GET https://api.sleeper.app/v1/user/{'{user_id}'}/leagues/nfl/{'{season}'}</p>
                <div class="sl-step__out" data-role="out"></div>
              </div>
            </li>
            <li class="sl-step" id="sl-step-drafts" data-status="idle">
              <div class="sl-step__rail"><span class="sl-step__n">3</span></div>
              <div class="sl-step__body">
                <div class="sl-step__head"><span class="sl-step__title">drafts().getAllDraftsForUser</span><span class="sl-step__pill" data-role="status">waiting</span><span class="sl-step__ms" data-role="ms"></span></div>
                <pre class="sl-step__java"><code data-role="java" set:html={java('List<Draft> drafts = sleeper.drafts().getAllDraftsForUser({user_id}, {season});')}></code></pre>
                <p class="sl-step__http" data-role="http">GET https://api.sleeper.app/v1/user/{'{user_id}'}/drafts/nfl/{'{season}'}</p>
                <div class="sl-step__out" data-role="out"></div>
              </div>
            </li>
          </ol>
        </div>
      </div>
    </section>

    <!-- [05] Where it led -->
    <section class="section sl-section" data-num="[05]" id="lineage">
      <div class="container">
        <SectionHead num="05" eyebrow="Where it led" title="One subclass, then a different product" lead="The fork's own change is small, and this page says so. The idea behind it grew into a separate project." />
        <div class="sl-rev">
          <div class="card sl-card sl-rev__block reveal">
            <div class="sl-rev__head"><span>Revision block</span><span>Fantasy-Football-Draft-Assistant</span></div>
            <div class="table-wrap sl-rev__wrap">
              <table class="table sl-rev__table">
                <thead><tr><th>Rev</th><th>When</th><th>Change</th><th>By</th></tr></thead>
                <tbody>
                  <tr><td class="mono">A</td><td>upstream</td><td>sdcalmes/sleeper-api: a Java adapter for the Sleeper API, MIT licensed, grouped the way the API docs are (Users, Leagues, Drafts, Players).</td><td class="mono">sdcalmes</td></tr>
                  <tr class="sl-rev__fork"><td class="mono">B</td><td>Jan 2024</td><td><code>footballDraft extends Draft</code> added in Draft/DraftModels: the starting point of a draft assistant.</td><td class="mono">SidSub1041</td></tr>
                  <tr><td class="mono">C</td><td>{draft.period}</td><td>{draft.name}: the assistant built as its own project in Python, 400 simulated drafts per pick, advises and never picks.</td><td class="mono">SidSub1041</td></tr>
                </tbody>
              </table>
            </div>
          </div>
          <div class="sl-rev__side">
            <div class="card sl-card sl-fork reveal" style="--i:1">
              <span class="sl-fork__path">src/main/java/com/sdcalmes/sleeper/Draft/DraftModels/footballDraft.java</span>
              <code class="sl-fork__code"><span class="tk-k">class</span> footballDraft <span class="tk-k">extends</span> <span class="tk-t">Draft</span></code>
              <p>An empty subclass of the Draft model, with no fields or methods yet. It is the whole of the fork's addition, and it marks where the draft-assistant idea started.</p>
            </div>
            <div class="card sl-card sl-next reveal" style="--i:2">
              <span class="sl-next__eyebrow"><span class="swatch" style={`--swatch:${draft.color}`}></span> Continued as {draft.name}</span>
              <p class="sl-next__line">{draft.oneLiner}</p>
              <dl class="kv sl-next__kv">
                {draft.facts.map((f) => <><dt>{f.label}</dt><dd>{f.value}</dd></>)}
              </dl>
              <a class="btn btn--primary btn--sm" href={url(draft.href)}>Open the {draft.tab} tab <Icon name="arrow-right" class="arrow" size={16} /></a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- More from the portfolio -->
    <section class="section section--tight section--bordered sl-section" id="more">
      <div class="container">
        <div class="between" style="margin-bottom:22px">
          <h2 class="sl-more__title reveal">More from the portfolio</h2>
          <a class="btn btn--ghost btn--sm reveal" href={url('/')}>All projects <Icon name="arrow-right" class="arrow" size={15} /></a>
        </div>
        <div class="sl-more">
          {others.map((o, i) => (
            <a class="card card--hover sl-card sl-more__card reveal" href={url(o.href)} style={`--swatch:${o.color}; --i:${i + 1}`}>
              <span class="sl-more__tab"><span class="swatch"></span> {o.tab}</span>
              <span class="sl-more__name">{o.name}</span>
              <span class="sl-more__line">{o.oneLiner}</span>
              <span class="sl-more__go">Open the tab <Icon name="arrow-right" class="arrow" size={15} /></span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </div>

  <!-- Dialogs -->
  <Dialog id="sl-endpoints" title="Endpoint reference" eyebrow={`${endpointCount} GET paths, as the Retrofit interfaces declare them`} wide>
    <p>Grouped the way the client is. Paths are relative to the base URL <code>http://api.sleeper.app/</code> set in SleeperApi.java; four of them are declared without the <code>v1/</code> prefix, quoted as found.</p>
    <div class="table-wrap" style="margin-top:16px">
      <table class="table sl-ep">
        <thead><tr><th>Group</th><th>Java</th><th>HTTP</th><th>Returns</th></tr></thead>
        <tbody>
          {endpoints.map((e) => (
            <tr>
              <td><span class="sl-ep__group">{e.group}</span></td>
              <td><code>{e.call}</code>{e.note && <span class="sl-ep__note">{e.note}</span>}</td>
              <td><code class="sl-ep__http">GET {e.http}</code></td>
              <td><code>{e.returns}</code></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <h3>Composed helpers</h3>
    <p>Two methods in LeagueImpl build on the calls above instead of declaring their own path.</p>
    <ul>
      {derivedHelpers.map((h) => <li><code>{h.call}</code><br /><span class="small muted">{h.detail}</span></li>)}
    </ul>
  </Dialog>

  <Dialog id="sl-index" title="Package index" eyebrow={`${files} classes under com.sdcalmes.sleeper, ${testClasses.length} test classes`}>
    <p>Every class in <code>src/main/java</code>, by package group, from the snapshot of the repository. The fork's addition is marked.</p>
    <div class="sl-index">
      {groupOrder.map((g) => (
        <div class="sl-index__group">
          <h4 class="sl-index__name">[{groupMeta[g].label}] <span class="muted">{groups[g].length}</span></h4>
          <ul role="list" class="sl-index__list">
            {groups[g].map((c) => <li class:list={{ 'is-fork': shortName(c) === 'footballDraft' }}>{c}{shortName(c) === 'footballDraft' && <span class="sl-index__flag">fork</span>}</li>)}
          </ul>
        </div>
      ))}
      <div class="sl-index__group">
        <h4 class="sl-index__name">[Tests] <span class="muted">{testClasses.length}</span></h4>
        <ul role="list" class="sl-index__list">{testClasses.map((t) => <li>{t}</li>)}</ul>
      </div>
    </div>
  </Dialog>

  <Dialog id="sl-build" title="Build and CI" eyebrow="build.gradle and .circleci/config.yml">
    <p>A Gradle Java library targeting Java {build.java}, published as <code>{build.artifact}</code> {build.version} with sources and javadoc jars. The CircleCI job runs on <code>{build.ciImage}</code>.</p>
    <h3>Plugins</h3>
    <ul>{build.plugins.map((pl) => <li><code>{pl}</code></li>)}</ul>
    <h3>Dependencies</h3>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Scope</th><th>Artifact</th><th class="num">Version</th></tr></thead>
        <tbody>{build.dependencies.map((d) => <tr><td><code>{d.scope}</code></td><td><code>{d.artifact}</code></td><td class="num">{d.version}</td></tr>)}</tbody>
      </table>
    </div>
    <h3>CircleCI steps</h3>
    <ol>{build.ciSteps.map((s) => <li>{s}</li>)}</ol>
    <h3>Test classes</h3>
    <p class="mono small">{testClasses.join(' · ')}</p>
    <p class="small muted">The README badge and the publishing coordinates point at the upstream project, sdcalmes/sleeper-api; the fork keeps them as they were.</p>
  </Dialog>

  <Dialog id="sl-explorer-notes" title="How the explorer works" eyebrow="Three GETs, no server, nothing kept">
    <p><b>What runs.</b> The same three requests the README examples wrap: the user by username, then that user's leagues and drafts for the chosen season. The Java line above each step is what the client would execute for it.</p>
    <p><b>Where it runs.</b> In your browser, directly against <code>https://api.sleeper.app</code>. This site is static; there is no server of mine in between and no proxy.</p>
    <p><b>What is kept.</b> Nothing. No cookies, no local storage, no analytics on this form. Reload the page and the results are gone.</p>
    <p><b>What it skips.</b> The players dump (<code>v1/players/nfl</code>) is deliberately not wired: it is about 5 MB and Sleeper asks that it run at most once a day.</p>
