---
/**
 * Home: a calmer, professional overview. Who, what, the five projects, the skills behind
 * them and where each was applied, and how the work gets done. Every number comes from
 * src/data/projects.ts, src/data/skills.ts or the JSON snapshots.
 */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Dialog from '../components/Dialog.astro';
import SectionHead from '../components/SectionHead.astro';
import Stat from '../components/Stat.astro';
import ProjectGraphic from '../components/home/ProjectGraphic.astro';
import { projects, projectById } from '../data/projects';
import { skillGroups } from '../data/skills';
import { site, url } from '../site.config';

const liveCount = projects.filter((p) => p.links.some((l) => l.kind === 'live')).length;
const languages = Array.from(new Set(projects.flatMap((p) => p.languages)));
const linesOfCode = 42375; // wc -l over the five repositories' source files (Python, Rust, TypeScript, JavaScript, Java, HTML, CSS), generated UI kits excluded
const allSkills = skillGroups.flatMap((g) => g.skills.map((s) => ({ ...s, group: g.title })));
const hasApp = (skillId: string, project: string) => allSkills.find((s) => s.id === skillId)?.applications.some((a) => a.project === project) ?? false;

const steps = [
  { title: 'Collect', text: 'Get the data without getting banned or going broke on API credits.', examples: [
    { project: 'nba', text: 'One league-wide game-log request per season, cached between runs, instead of one request per player; an HTTP layer with timeouts, retries and a circuit breaker.' },
    { project: 'kalshi', text: 'A resumable Rust collector that pulled 882 games and 66k+ events under Kalshi’s public rate limit.' },
  ] },
  { title: 'Model', text: 'Turn a projection into a probability, then put it next to a price.', examples: [
    { project: 'nba', text: 'Two seasons of game logs blended by sample size, a matchup multiplier, a distribution per stat, and a de-vigged market price to beat.' },
    { project: 'kalshi', text: 'An event study of 455 plate appearances: immediate reaction, drift, volume and spread, by event type and inning.' },
  ] },
  { title: 'Validate', text: 'Hold every result to a baseline, and keep the audits that said no.', examples: [
    { project: 'kalshi', text: 'A survivorship-bias audit invalidated the original edge; recency and streak weighting were rejected when the data said no.' },
    { project: 'nfl', text: 'A 2022–2024 held-out test (854 games) alongside the single-season fit the dashboard shows.' },
  ] },
  { title: 'Ship', text: 'Put the model where people already are.', examples: [
    { project: 'draft', text: 'A web app, a Chrome sidebar that docks beside the draft room, and an 18-tool MCP server so Claude can run the draft.' },
    { project: 'nfl', text: 'Dashboards that redeploy on every data push, with the method one dialog away.' },
  ] },
  { title: 'Monitor', text: 'Grade the output every day and make the limits durable.', examples: [
    { project: 'nba', text: 'Nightly grading against the closing line, a learner kept in shadow mode until it earns its way out, and a written post-mortem each morning.' },
    { project: 'kalshi', text: 'A risk layer with exposure caps, a daily-loss lockout written to disk and a dead-man switch: no bypass, by design.' },
  ] },
];
---
<Base title={`${site.name} — ${site.role}`} description={site.description}>
  <div class="home">
    <!-- Hero -->
    <section class="hero home-hero" aria-labelledby="home-title">
      <div class="hero__bg home-hero__bg" aria-hidden="true">
        <span class="home-hero__ring" data-parallax="0.06"></span>
        <span class="home-hero__block" data-parallax="0.1"></span>
      </div>
      <div class="container home-hero__grid">
        <div class="home-hero__copy">
          <span class="kicker reveal"><span class="dot"></span> Portfolio · five projects, one place</span>
          <h1 id="home-title" class="reveal" style="--i:1">{site.tagline}</h1>
          <p class="lead reveal" style="--i:2">Five projects across the NBA, Kalshi’s MLB markets, NFL totals and fantasy-football drafts: data pipelines, statistical models and the web apps that put them in front of people. Each one publishes its record.</p>
          <div class="hero__actions reveal" style="--i:3">
            <a class="btn btn--primary btn--lg" href="#projects">See the projects <Icon name="arrow-down" size={16} class="arrow" /></a>
            <button class="btn btn--ghost btn--lg" type="button" data-dialog-open="contact"><Icon name="mail" size={16} /> Get in touch</button>
          </div>
          <ul class="home-hero__links reveal" style="--i:4" role="list">
            <li><a href={site.github}><Icon name="github" size={16} /> github.com/{site.githubHandle}</a></li>
            <li><a href={site.tableau}><Icon name="bar-chart" size={16} /> Tableau Public</a></li>
            {site.linkedin && <li><a href={site.linkedin}><Icon name="linkedin" size={16} /> LinkedIn</a></li>}
          </ul>
        </div>
        <figure class="portrait reveal reveal--scale" style="--i:2">
          {site.headshot ? (
            <img class="portrait__img" src={url(site.headshot)} alt={site.headshotAlt} width="800" height="800" loading="eager" decoding="async" fetchpriority="high" />
          ) : (
            <div class="portrait__placeholder" role="img" aria-label={`${site.name}, portrait placeholder`}>
              <span class="portrait__grid" aria-hidden="true"></span>
              <span class="portrait__initials" aria-hidden="true">{site.initials}</span>
              <span class="portrait__corner" aria-hidden="true"></span>
            </div>
          )}
          <figcaption class="portrait__cap"><b>{site.name}</b><span>{site.role}</span></figcaption>
        </figure>
      </div>
    </section>

    <!-- Proof strip -->
    <section class="home-proof" aria-label="At a glance">
      <div class="container">
        <div class="stat-row">
          <Stat label="Projects" value={String(projects.length)} count={projects.length} sub="each with its own tab" />
          <Stat label="Live deployments" value={String(liveCount)} count={liveCount} sub="a nightly board, a draft app, a dashboard" />
          <Stat label="Languages" value={String(languages.length)} count={languages.length} sub={languages.join(', ')} />
          <Stat label="Lines of code" value="42k" count={linesOfCode} format="k" sub="across the five repositories" />
        </div>
      </div>
    </section>

    <!-- About -->
    <section class="section section--tight" id="about" aria-labelledby="about-title">
      <div class="container">
        <div class="split home-about">
          <div>
            <span class="eyebrow reveal">About</span>
            <h2 id="about-title" class="reveal" style="--i:1">Questions about games, answered with pipelines.</h2>
            <div class="prose home-about__text">
              {site.about.map((para, i) => <p class="reveal" style={`--i:${i + 2}`}>{para}</p>)}
            </div>
          </div>
          <aside class="card home-now reveal reveal--left" style="--i:2" aria-labelledby="now-title">
            <span class="eyebrow eyebrow--plain" id="now-title">Now</span>
            <ul role="list" class="home-now__list">
              {site.now.map((n) => <li><span class="home-now__dot" aria-hidden="true"></span>{n}</li>)}
            </ul>
            <hr class="divider" />
            <div class="home-now__links">
              <a class="home-now__link" href={site.github}><Icon name="github" size={18} /><span><b>GitHub</b><span>All five repositories</span></span><Icon name="arrow-up-right" size={14} class="ico home-now__go" /></a>
              <a class="home-now__link" href={site.tableau}><Icon name="bar-chart" size={18} /><span><b>Tableau Public</b><span>The NBA model’s dashboard</span></span><Icon name="arrow-up-right" size={14} class="ico home-now__go" /></a>
              <button class="home-now__link" type="button" data-dialog-open="contact"><Icon name="mail" size={18} /><span><b>Email</b><span>{site.email}</span></span><Icon name="arrow-right" size={14} class="ico home-now__go" /></button>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- Projects -->
    <section class="section section--bordered" id="projects" aria-labelledby="projects-title">
      <div class="container">
        <SectionHead eyebrow="Projects" title="Five projects, five tabs" lead="Each tab keeps the project’s own design and shows real data from its repository: the record, the method, the pipeline and the code." id="projects-title" />
        <div class="home-projects">
          {projects.map((p, i) => (
            <article class="card card--hover home-project reveal" id={`project-${p.id}`} style={`--swatch:${p.color};--swatch-ink:${p.ink};--i:${i + 1}`}>
              <header class="home-project__head">
                <span class="home-project__tab"><span class="swatch" aria-hidden="true"></span>{p.tab}</span>
                <span class="home-project__period mono">{p.period}</span>
              </header>
              <h3><a href={url(p.href)}>{p.name}</a></h3>
              <p class="home-project__line">{p.oneLiner}</p>
              <div class="home-project__graphic"><ProjectGraphic id={p.id} /></div>
              <dl class="home-project__facts">
                {p.facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
              </dl>
              <div class="home-project__foot">
                <div class="cluster" style="--cluster:6px">{p.stack.slice(0, 4).map((s) => <span class="chip">{s}</span>)}</div>
                <a class="btn btn--soft btn--sm" href={url(p.href)}>Open the tab <Icon name="arrow-right" size={14} class="arrow" /></a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Skills -->
    <section class="section section--bordered" id="skills" aria-labelledby="skills-title">
      <div class="container">
        <SectionHead eyebrow="Skills" title="What I use, and where it was applied" lead="Click any skill to see the exact place it shows up in the projects. The matrix below is the same information at a glance." id="skills-title" />
        <div class="home-skills">
          {skillGroups.map((g, gi) => (
            <div class="home-skillgroup reveal" style={`--i:${gi + 1}`}>
              <h3 class="home-skillgroup__title">{g.title}</h3>
              <div class="cluster" style="--cluster:8px">
                {g.skills.map((s) => (
                  <button class="chip chip--outline chip--btn home-skill" type="button" data-dialog-open={`skill-${s.id}`}>{s.name} <span class="home-skill__n" aria-label={`${s.applications.length} projects`}>{s.applications.length}</span></button>
                ))}
              </div>
            </div>
          ))}
        </div>
        <div class="table-wrap home-matrix reveal">
          <table class="table">
            <caption class="sr-only">Skills by project</caption>
            <thead>
              <tr>
                <th scope="col">Skill</th>
                {projects.map((p) => <th scope="col" class="home-matrix__proj"><a href={url(p.href)}><span class="swatch" style={`--swatch:${p.color}`} aria-hidden="true"></span>{p.tab}</a></th>)}
              </tr>
            </thead>
            <tbody>
              {allSkills.map((s) => (
                <tr>
                  <th scope="row"><button class="home-matrix__skill" type="button" data-dialog-open={`skill-${s.id}`}>{s.name}<span class="home-matrix__group">{s.group}</span></button></th>
                  {projects.map((p) => (
                    <td class="home-matrix__cell">
                      {hasApp(s.id, p.id) ? <span class="home-matrix__yes" style={`--swatch:${p.ink}`} title={`${s.name} in ${p.name}`}><Icon name="check" size={14} /><span class="sr-only">yes</span></span> : <span class="home-matrix__no" aria-hidden="true"></span>}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- How I work -->
    <section class="section section--bordered" id="process" aria-labelledby="process-title">
      <div class="container">
        <SectionHead eyebrow="How I work" title="From a question to something that runs on its own" lead="The same five moves show up in every project, so here they are once, with an example from the repositories for each." id="process-title" />
        <ol class="step-list home-steps" role="list">
          {steps.map((st, i) => (
            <li class="step home-step reveal" style={`--i:${i + 1}`}>
              <span class="step__num" aria-hidden="true"></span>
              <div class="home-step__body">
                <h3>{st.title}</h3>
                <p>{st.text}</p>
                <ul class="home-step__examples" role="list">
                  {st.examples.map((ex) => <li><a class="home-step__tag" href={url(projectById[ex.project as keyof typeof projectById].href)} style={`--swatch:${projectById[ex.project as keyof typeof projectById].color}`}><span class="swatch" aria-hidden="true"></span>{projectById[ex.project as keyof typeof projectById].tab}</a><span>{ex.text}</span></li>)}
                </ul>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Contact band -->
    <section class="section home-contact" aria-labelledby="contact-title">
      <div class="container">
        <div class="home-contact__card reveal reveal--scale">
          <div>
            <span class="eyebrow eyebrow--plain">Contact</span>
            <h2 id="contact-title">Working on something with real data? Let’s talk.</h2>
            <p class="lead">Analytics and engineering roles, collaborations on a model, or questions about any of the projects.</p>
          </div>
          <div class="home-contact__actions">
            <button class="btn btn--primary btn--lg" type="button" data-dialog-open="contact"><Icon name="mail" size={16} /> Open the contact form</button>
            <a class="home-contact__email mono" href={`mailto:${site.email}`}>{site.email}</a>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Skill dialogs -->
  {allSkills.map((s) => (
    <Dialog id={`skill-${s.id}`} title={s.name} eyebrow={s.group}>
      <p>{s.blurb}</p>
      <ul class="home-apps" role="list">
        {s.applications.map((a) => {
          const p = projectById[a.project];
          return (
            <li class="home-app" style={`--swatch:${p.color}`}>
              <a class="home-app__proj" href={url(p.href)}><span class="swatch" aria-hidden="true"></span>{p.name} <Icon name="arrow-right" size={14} class="arrow" /></a>
              <p>{a.detail}</p>
            </li>
          );
        })}
      </ul>
    </Dialog>
  ))}
</Base>

<style>
  /* ---- Hero ---- */
  .home-hero { padding-top: clamp(48px, 7vw, 96px); padding-bottom: clamp(48px, 7vw, 96px); }
  .home-hero__bg {
    background-image: linear-gradient(color-mix(in srgb, var(--fg) 5%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--fg) 5%, transparent) 1px, transparent 1px);
    background-size: 48px 48px;
    -webkit-mask-image: radial-gradient(120% 90% at 70% 10%, #000 20%, transparent 70%);
    mask-image: radial-gradient(120% 90% at 70% 10%, #000 20%, transparent 70%);
  }
  .home-hero__ring { position: absolute; width: min(56vw, 640px); aspect-ratio: 1; right: -12%; top: -30%; border-radius: 50%; border: clamp(28px, 4vw, 56px) solid var(--accent); opacity: 0.09; }
  .home-hero__block { position: absolute; width: clamp(80px, 10vw, 140px); aspect-ratio: 1; right: 36%; bottom: 6%; background: var(--hl); border-radius: 18px; transform: rotate(12deg); opacity: 0.9; }
  .home-hero__grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr); gap: clamp(32px, 6vw, 96px); align-items: center; }
  .home-hero__copy h1 { margin-top: 6px; max-width: 16ch; }
  .home-hero__copy .lead { margin-top: 24px; }
  .home-hero__links { display: flex; flex-wrap: wrap; gap: 8px 22px; margin-top: 28px; font-family: var(--font-mono); font-size: 0.82rem; color: var(--fg-2); }
  .home-hero__links a { display: inline-flex; align-items: center; gap: 8px; color: inherit; text-decoration: none; padding: 4px 0; border-bottom: 1px solid transparent; transition: color 0.2s, border-color 0.2s; }
  .home-hero__links a:hover { color: var(--accent); border-color: var(--accent); }
  .home-hero__links svg { color: var(--accent); }

  .portrait { margin: 0; display: grid; gap: 12px; justify-self: end; width: min(100%, 400px); }
  .portrait__img, .portrait__placeholder { width: 100%; aspect-ratio: 1; border-radius: 22px; object-fit: cover; box-shadow: var(--shadow-2); }
  .portrait__placeholder { position: relative; overflow: hidden; display: grid; place-items: center; background: linear-gradient(145deg, #141a2e 0%, #1f3fe6 100%); border: 1px solid var(--line-strong); }
  .portrait__grid { position: absolute; inset: 0; background-image: linear-gradient(rgba(255, 255, 255, 0.09) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.09) 1px, transparent 1px); background-size: 40px 40px; }
  .portrait__initials { position: relative; font-family: var(--font-display); font-weight: 700; font-size: clamp(6rem, 12vw, 9rem); letter-spacing: -0.06em; color: #fff; line-height: 1; }
  .portrait__corner { position: absolute; right: 22px; bottom: 22px; width: 42px; height: 42px; border-radius: 10px; background: var(--hl); }
  .portrait__cap { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; font-size: 0.85rem; color: var(--fg-3); font-family: var(--font-mono); }
  .portrait__cap b { color: var(--fg); font-weight: 600; }
  @media (max-width: 960px) {
    .home-hero__grid { grid-template-columns: 1fr; }
    .portrait { justify-self: start; width: min(100%, 320px); }
    .home-hero__block { right: 8%; bottom: 30%; }
  }

  /* ---- Proof strip ---- */
  .home-proof .stat-row { border-top: 0; }

  /* ---- About ---- */
  .home-about { align-items: start; }
  .home-about h2 { margin-top: 14px; max-width: 18ch; }
  .home-about__text { margin-top: 22px; }
  .home-about__text p { color: var(--fg-2); font-size: 1.05rem; }
  .home-now { display: grid; gap: 16px; }
  .home-now__list { display: grid; gap: 10px; font-size: 0.98rem; }
  .home-now__list li { display: grid; grid-template-columns: 14px 1fr; gap: 12px; align-items: start; color: var(--fg-2); }
  .home-now__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); margin-top: 8px; box-shadow: 0 0 0 4px var(--accent-soft); }
  .home-now .divider { margin-block: 4px; }
  .home-now__links { display: grid; gap: 6px; }
  .home-now__link { display: grid; grid-template-columns: 22px 1fr 16px; align-items: center; gap: 12px; padding: 10px 12px; border-radius: 10px; text-align: left; font: inherit; color: inherit; transition: background 0.2s; cursor: pointer; }
  .home-now__link:hover { background: var(--bg-sunk); }
  .home-now__link > svg { color: var(--accent); }
  .home-now__link b { display: block; font-size: 0.95rem; }
  .home-now__link span span { display: block; font-size: 0.8rem; color: var(--fg-3); font-family: var(--font-mono); overflow-wrap: anywhere; }
  .home-now__go { color: var(--fg-3); transition: transform 0.25s var(--ease-out), color 0.2s; }
  .home-now__link:hover .home-now__go { transform: translate(2px, -2px); color: var(--accent); }

  /* ---- Projects (bento) ---- */
  .home-projects { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: clamp(16px, 2vw, 24px); }
  .home-project { grid-column: span 2; display: grid; gap: 14px; align-content: start; padding: 24px; }
  .home-project:nth-child(1), .home-project:nth-child(2) { grid-column: span 3; }
  .home-project::before { content: ''; position: absolute; inset: 0 auto auto 0; width: 100%; height: 4px; border-radius: var(--radius-lg) var(--radius-lg) 0 0; background: var(--swatch); }
  .home-project__head { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .home-project__tab { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 0.74rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--fg-2); }
  .home-project__period { font-size: 0.74rem; color: var(--fg-3); }
  .home-project h3 { font-size: clamp(1.35rem, 1.1rem + 0.8vw, 1.7rem); }
  .home-project h3 a { color: inherit; text-decoration: none; }
  .home-project h3 a:hover { color: var(--swatch-ink); }
  .home-project__line { color: var(--fg-2); font-size: 0.98rem; }
  .home-project__graphic { margin-top: 4px; }
  .home-project__facts { display: grid; gap: 8px; margin-top: 4px; }
  .home-project__facts div { display: grid; grid-template-columns: 112px 1fr; gap: 10px; font-size: 0.86rem; padding-top: 8px; border-top: 1px solid var(--line); }
  .home-project__facts dt { font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--fg-3); padding-top: 3px; }
  .home-project__facts dd { color: var(--fg-2); }
  .home-project__foot { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-top: auto; padding-top: 10px; }
  .home-project .btn--soft { color: var(--swatch-ink); background: color-mix(in srgb, var(--swatch) 14%, transparent); }
  .home-project .btn--soft:hover { background: color-mix(in srgb, var(--swatch) 26%, transparent); }
  @media (max-width: 1040px) { .home-project, .home-project:nth-child(1), .home-project:nth-child(2) { grid-column: span 3; } }
  @media (max-width: 700px) { .home-projects { grid-template-columns: 1fr; } .home-project, .home-project:nth-child(1), .home-project:nth-child(2) { grid-column: auto; } .home-project__facts div { grid-template-columns: 1fr; gap: 2px; } }

  /* ---- Skills ---- */
  .home-skills { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 40px; margin-bottom: 36px; }
  .home-skillgroup__title { font-size: 0.95rem; margin-bottom: 12px; color: var(--fg-2); font-family: var(--font-mono); font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; }
  .home-skill { font-family: var(--font-body); font-size: 0.9rem; padding: 9px 12px; gap: 8px; }
  .home-skill__n { display: inline-grid; place-items: center; min-width: 20px; height: 20px; padding: 0 6px; border-radius: 999px; background: var(--accent-soft); color: var(--accent); font-family: var(--font-mono); font-size: 0.7rem; font-weight: 600; }
  .home-matrix .table th:first-child, .home-matrix .table td:first-child { position: sticky; left: 0; background: var(--bg-elev); z-index: 1; }
  .home-matrix .table thead th:first-child { background: var(--bg-sunk); z-index: 2; }
  .home-matrix__proj a { display: inline-flex; align-items: center; gap: 7px; color: var(--fg-2); text-decoration: none; white-space: nowrap; }
  .home-matrix__proj a:hover { color: var(--accent); }
  .home-matrix__skill { font: inherit; color: var(--fg); text-align: left; cursor: pointer; display: grid; gap: 2px; font-weight: 500; }
  .home-matrix__skill:hover { color: var(--accent); }
  .home-matrix__group { font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--fg-3); font-weight: 400; }
  .home-matrix__cell { text-align: center; vertical-align: middle; }
  .home-matrix__yes { display: inline-grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: color-mix(in srgb, var(--swatch) 16%, transparent); color: var(--swatch); }
  .home-matrix__no { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--line-strong); }
  @media (max-width: 760px) { .home-skills { grid-template-columns: 1fr; } }

  /* ---- Steps ---- */
  .home-steps { max-width: 980px; }
  .home-step { grid-template-columns: 64px 1fr; }
