---
/**
 * Home, laid out like the template: name and profession, "01 / Profile", "02 / Capabilities",
 * "03 / Selected work", "04 / Approach", an optional "05 / Background", and "06 / Next conversation".
 * Three sports balls bounce through the hero and dissolve into the name (scripts/home-balls.ts).
 */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Dialog from '../components/Dialog.astro';
import SectionHead from '../components/SectionHead.astro';
import ProjectGraphic from '../components/home/ProjectGraphic.astro';
import { projects, projectById } from '../data/projects';
import { skillGroups } from '../data/skills';
import { site, url } from '../site.config';

const allSkills = skillGroups.flatMap((g) => g.skills.map((s) => ({ ...s, group: g.title })));
const hasApp = (skillId: string, project: string) => allSkills.find((s) => s.id === skillId)?.applications.some((a) => a.project === project) ?? false;
const n = (v: number) => String(v).padStart(2, '0');

const core = [
  { name: 'Modeling and pricing', note: 'Projections, probabilities, de-vigged prices and edge. Closing-line value is the test I trust.', tools: 'Python · pandas · SciPy · scikit-learn' },
  { name: 'Pipelines that run alone', note: 'Scheduled jobs that collect, grade and publish, and refuse to publish bad output.', tools: 'GitHub Actions · launchd · Rust · SQLite' },
  { name: 'Research honesty', note: 'Walk-forward checks, pre-registered cuts, and audits that can kill an edge.', tools: 'Event studies · backtests · post-mortems' },
  { name: 'Shipping the model', note: 'Dashboards, a browser extension and an MCP server, so the model gets used and not only run.', tools: 'Next.js · Astro · Chrome MV3 · Docker · Vercel · Fly.io' },
];

const steps = [
  { title: 'Collect', text: 'Get the data without getting blocked or burning API credits.', examples: [
    { project: 'nba', text: 'One league-wide game-log request per season, cached between runs. Timeouts, retries and a circuit breaker on every call.' },
    { project: 'kalshi', text: 'A resumable Rust collector that pulled 882 games and 66k+ events under Kalshi’s public rate limit.' },
  ] },
  { title: 'Model', text: 'Turn a projection into a probability, then put it next to a price.', examples: [
    { project: 'nba', text: 'Two seasons of game logs blended by sample size, a matchup multiplier, a distribution per stat, and a de-vigged market price to beat.' },
    { project: 'kalshi', text: 'An event study of 455 plate appearances: immediate move, drift, volume and spread, by play type and inning.' },
  ] },
  { title: 'Validate', text: 'Hold every result to a baseline. Keep the audits that said no.', examples: [
    { project: 'kalshi', text: 'A survivorship-bias audit killed the original edge. Recency and streak weighting were rejected the same way.' },
    { project: 'nfl', text: 'A held-out test on 854 games from 2022 to 2024, shown next to the single-season fit.' },
  ] },
  { title: 'Ship', text: 'Put the model where people already are.', examples: [
    { project: 'draft', text: 'A web app, a Chrome sidebar beside the draft room, and an 18-tool MCP server so Claude can run the draft.' },
    { project: 'nfl', text: 'Dashboards that redeploy on every data push, with the method one dialog away.' },
  ] },
  { title: 'Monitor', text: 'Grade the output every day. Make the limits hard to bypass.', examples: [
    { project: 'nba', text: 'Nightly grading against the closing line, a learner kept in shadow mode until it earns its way out, and a post-mortem each morning.' },
    { project: 'kalshi', text: 'Exposure caps, a daily-loss lockout written to disk and a dead-man switch. No bypass, by design.' },
  ] },
];
const hasBackground = site.experience.length > 0 || site.education.length > 0;
const contactNum = hasBackground ? '06' : '05';
---
<Base title={`${site.name} — ${site.profession}`} description={site.description}>
  <div class="home">
    <!-- Hero -->
    <section class="hero home-hero" aria-labelledby="home-title">
      <canvas class="home-balls" id="home-balls" aria-hidden="true"></canvas>
      <div class="container home-hero__grid">
        <div class="home-hero__copy">
          <span class="eyebrow reveal"><span class="eyebrow__num">Portfolio</span><span class="eyebrow__slash">/</span><span>Selected work</span></span>
          <h1 id="home-title" class="home-h1 reveal" style="--i:1">{site.name}</h1>
          <p class="subhead reveal" style="--i:2">{site.profession}</p>
          <p class="lead reveal" style="--i:3">{site.tagline}</p>
          <hr class="rule reveal" style="--i:4" />
          <p class="meta-line reveal" style="--i:5">
            <span>Selected work</span><span class="sep">·</span><span>{site.years}</span><span class="sep">·</span><span>{projects.length} projects</span>
            {site.basedIn && <><span class="sep">·</span><span>{site.basedIn}</span></>}
          </p>
          <div class="hero__actions reveal" style="--i:6">
            <a class="btn btn--primary" href="#work">See the work <Icon name="arrow-down" size={16} class="arrow" /></a>
            <button class="btn btn--ghost" type="button" data-dialog-open="contact"><Icon name="mail" size={16} /> Get in touch</button>
          </div>
        </div>
        <figure class="portrait reveal" style="--i:2">
          {site.headshot ? (
            <img class="portrait__img" src={url(site.headshot)} alt={site.headshotAlt} width="800" height="800" loading="eager" decoding="async" fetchpriority="high" />
          ) : (
            <div class="portrait__placeholder" role="img" aria-label={`${site.name}, portrait placeholder`}>
              <span class="portrait__initials" aria-hidden="true">{site.initials}</span>
              <span class="portrait__tag mono" aria-hidden="true">Portrait</span>
            </div>
          )}
          <figcaption class="portrait__cap"><b>{site.name}</b><span>{site.profession}</span></figcaption>
        </figure>
      </div>
    </section>

    <!-- 01 / Profile -->
    <section class="section" id="about" aria-labelledby="about-title">
      <div class="container">
        <SectionHead num="01" eyebrow="Profile" title="A little about me" id="about-title" rule={false} />
        <div class="home-about">
          <div class="prose home-about__text">
            {site.about.map((para, i) => <p class="reveal" style={`--i:${i + 1}`}>{para}</p>)}
          </div>
          <aside class="home-now reveal" style="--i:2" aria-labelledby="now-title">
            <span class="eyebrow eyebrow--plain" id="now-title">Now</span>
            <ul role="list" class="home-now__list">
              {site.now.map((item) => <li><span class="home-now__dot" aria-hidden="true"></span>{item}</li>)}
            </ul>
          </aside>
        </div>
        <hr class="rule reveal" />
        <dl class="cols-3 home-profile reveal" style="--i:1">
          {site.basedIn && <div class="col-field"><dt>Based in</dt><dd>{site.basedIn}</dd></div>}
          <div class="col-field"><dt>Focus</dt><dd>{site.focus}</dd></div>
          <div class="col-field"><dt>Availability</dt><dd>{site.availability}</dd></div>
          <div class="col-field"><dt>Elsewhere</dt><dd><a href={site.github}>GitHub</a> · <a href={site.tableau}>Tableau Public</a>{site.linkedin && <> · <a href={site.linkedin}>LinkedIn</a></>}</dd></div>
        </dl>
      </div>
    </section>

    <!-- 02 / Capabilities -->
    <section class="section section--bordered" id="skills" aria-labelledby="skills-title">
      <div class="container">
        <SectionHead num="02" eyebrow="Capabilities" title="Skills and approach" id="skills-title" lead="Four things I do well, then the full list with the exact place each skill shows up in the projects." />
        <div class="cols-4 home-core">
          {core.map((c, i) => (
            <div class="home-core__item reveal" style={`--i:${i + 1}`}>
              <h3><span class="home-core__num">{n(i + 1)}</span> <span class="home-core__sep">·</span> {c.name}</h3>
              <p>{c.note}</p>
              <p class="home-core__tools">{c.tools}</p>
            </div>
          ))}
        </div>
        <hr class="rule reveal" style="margin:40px 0 32px" />
        <h3 class="home-sub reveal">Tools and working methods</h3>
        <p class="home-sub__note reveal" style="--i:1">Click a skill to see where it was applied.</p>
        <div class="home-skills">
          {skillGroups.map((g, gi) => (
            <div class="home-skillgroup reveal" style={`--i:${gi + 1}`}>
              <h4 class="home-skillgroup__title">{g.title}</h4>
              <div class="cluster" style="--cluster:8px">
                {g.skills.map((s) => (
                  <button class="chip chip--outline chip--btn home-skill" type="button" data-dialog-open={`skill-${s.id}`}>{s.name} <span class="home-skill__n" aria-label={`${s.applications.length} projects`}>{s.applications.length}</span></button>
                ))}
              </div>
            </div>
          ))}
        </div>
        <div class="table-wrap home-matrix reveal">
          <table class="table">
            <caption class="sr-only">Skills by project</caption>
            <thead>
              <tr>
                <th scope="col">Skill</th>
                {projects.map((p) => <th scope="col" class="home-matrix__proj"><a href={url(p.href)}><span class="swatch" style={`--swatch:${p.color}`} aria-hidden="true"></span>{p.tab}</a></th>)}
              </tr>
            </thead>
            <tbody>
              {allSkills.map((s) => (
                <tr>
                  <th scope="row"><button class="home-matrix__skill" type="button" data-dialog-open={`skill-${s.id}`}>{s.name}<span class="home-matrix__group">{s.group}</span></button></th>
                  {projects.map((p) => (
                    <td class="home-matrix__cell">
                      {hasApp(s.id, p.id) ? <span class="home-matrix__yes" style={`--swatch:${p.ink}`} title={`${s.name} in ${p.name}`}><Icon name="check" size={14} /><span class="sr-only">yes</span></span> : <span class="home-matrix__no" aria-hidden="true"></span>}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- 03 / Selected work -->
    <section class="section section--bordered" id="work" aria-labelledby="work-title">
      <div class="container">
        <SectionHead num="03" eyebrow="Selected work" title="Five projects, five case studies" id="work-title" lead="Each one has its own tab with its own design, real data from its repository, and the code." />
        <ol class="home-work" role="list">
          {projects.map((p, i) => (
            <li class="home-case reveal" id={`project-${p.id}`} style={`--swatch:${p.color};--swatch-ink:${p.ink};--i:${i + 1}`}>
              <div class="home-case__head">
                <span class="eyebrow"><span class="eyebrow__num">{n(i + 3)}</span><span class="eyebrow__slash">/</span><span>Case study {n(i + 1)}</span></span>
                <span class="meta-line"><span>{p.period}</span></span>
              </div>
              <div class="home-case__body">
                <div class="home-case__text">
                  <h3><a href={url(p.href)}>{p.name}</a></h3>
                  <p class="home-case__line">{p.oneLiner}</p>
                  <dl class="case-meta__row home-case__meta">
                    <div><dt>Role</dt><dd>{p.role}</dd></div>
                    <div><dt>Context</dt><dd>{p.context}</dd></div>
                  </dl>
                  <p class="home-case__summary">{p.summary}</p>
                  <div class="home-case__foot">
                    <div class="cluster" style="--cluster:6px">{p.stack.slice(0, 4).map((s) => <span class="chip">{s}</span>)}</div>
                    <a class="btn btn--primary btn--sm" href={url(p.href)}>Open the case study <Icon name="arrow-right" size={14} class="arrow" /></a>
                  </div>
                </div>
                <div class="home-case__panel panel--dark">
                  <ProjectGraphic id={p.id} />
                </div>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 04 / Approach -->
    <section class="section section--bordered" id="process" aria-labelledby="process-title">
      <div class="container">
        <SectionHead num="04" eyebrow="Approach" title="From a question to something that runs on its own" id="process-title" lead="The same five moves show up in every project. Here they are once, with an example from the repositories for each." />
        <ol class="step-list home-steps" role="list">
          {steps.map((st, i) => (
            <li class="step home-step reveal" style={`--i:${i + 1}`}>
              <span class="step__num" aria-hidden="true"></span>
              <div class="home-step__body">
                <h3>{st.title}</h3>
                <p>{st.text}</p>
                <ul class="home-step__examples" role="list">
                  {st.examples.map((ex) => <li><a class="home-step__tag" href={url(projectById[ex.project as keyof typeof projectById].href)} style={`--swatch:${projectById[ex.project as keyof typeof projectById].color}`}><span class="swatch" aria-hidden="true"></span>{projectById[ex.project as keyof typeof projectById].tab}</a><span>{ex.text}</span></li>)}
                </ul>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {hasBackground && (
      <section class="section section--bordered" id="background" aria-labelledby="background-title">
        <div class="container">
          <SectionHead num="05" eyebrow="Background" title="Experience and education" id="background-title" />
          {site.experience.length > 0 && (
            <div class="home-bg">
              <h3 class="home-sub">Selected experience</h3>
              <ul role="list" class="home-bg__list">
                {site.experience.map((e) => <li class="home-bg__item reveal"><span class="home-bg__years mono">{e.years}</span><div><b>{e.title}</b><p>{e.detail}</p></div></li>)}
              </ul>
            </div>
          )}
          {site.education.length > 0 && (
            <div class="home-bg">
              <h3 class="home-sub">Education</h3>
              <dl class="cols-3">{site.education.map((e) => <div class="col-field reveal"><dt>{e.title}</dt><dd>{e.detail}</dd></div>)}</dl>
            </div>
          )}
        </div>
      </section>
    )}

    <!-- Next conversation -->
    <section class="section section--bordered home-contact" id="conversation" aria-labelledby="contact-title">
      <div class="container">
        <SectionHead num={contactNum} eyebrow="Next conversation" title="Let’s build something with real data." id="contact-title" lead="Analytics and engineering roles, a collaboration on a model, or a question about any of the projects. Email is fastest." />
        <dl class="cols-3 home-contact__cols reveal">
          <div class="col-field col-field--mono"><dt>Email</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
          <div class="col-field col-field--mono"><dt>{site.website ? 'Website' : 'Code'}</dt><dd><a href={site.website || site.github}>{(site.website || site.github).replace(/^https?:\/\//, '')}</a></dd></div>
          <div class="col-field col-field--mono"><dt>Social links</dt><dd><a href={site.github}>GitHub</a> · <a href={site.tableau}>Tableau</a>{site.linkedin && <> · <a href={site.linkedin}>LinkedIn</a></>}</dd></div>
        </dl>
        <div class="hero__actions reveal" style="--i:1"><button class="btn btn--primary btn--lg" type="button" data-dialog-open="contact"><Icon name="mail" size={16} /> Open the contact form</button></div>
      </div>
    </section>
  </div>

  {allSkills.map((s) => (
    <Dialog id={`skill-${s.id}`} title={s.name} eyebrow={s.group}>
      <p>{s.blurb}</p>
      <ul class="home-apps" role="list">
        {s.applications.map((a) => {
          const p = projectById[a.project];
          return (
            <li class="home-app" style={`--swatch:${p.color}`}>
              <a class="home-app__proj" href={url(p.href)}><span class="swatch" aria-hidden="true"></span>{p.name} <Icon name="arrow-right" size={14} class="arrow" /></a>
              <p>{a.detail}</p>
            </li>
          );
        })}
      </ul>
    </Dialog>
  ))}
  <script src="../scripts/home-balls.ts"></script>
</Base>

<style>
  /* ---- Hero ---- */
  .home-hero { padding-top: clamp(56px, 8vw, 110px); padding-bottom: clamp(72px, 10vw, 130px); background: var(--bg); }
  .home-balls { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; }
  .home-balls.is-done { display: none; }
  .home-hero__grid { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(240px, 0.7fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  .home-h1 { font-size: clamp(3rem, 2rem + 5.5vw, 6.4rem); letter-spacing: -0.035em; line-height: 0.98; margin-top: 18px; color: color-mix(in srgb, var(--fg) 22%, transparent); transition: color 1.1s var(--ease-out); }
  .home-h1.is-filled { color: var(--fg); }
  .home-hero .subhead { margin-top: 16px; }
  .home-hero .lead { margin-top: 20px; }
  .home-hero .rule { margin-top: 32px; }
  .home-hero .meta-line { margin-top: 18px; }
  .home-hero .hero__actions { margin-top: 28px; }
  .portrait { margin: 0; display: grid; gap: 10px; justify-self: end; width: min(100%, 360px); }
  .portrait__img, .portrait__placeholder { width: 100%; aspect-ratio: 1; object-fit: cover; }
  .portrait__placeholder { position: relative; display: grid; place-items: center; background: var(--fg); color: var(--bg); }
  .portrait__initials { font-family: var(--font-display); font-weight: 700; font-size: clamp(5rem, 10vw, 7.5rem); letter-spacing: -0.06em; line-height: 1; }
  .portrait__tag { position: absolute; left: 16px; bottom: 14px; font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase; color: color-mix(in srgb, var(--bg) 70%, transparent); }
  .portrait__cap { display: grid; gap: 2px; font-size: 0.82rem; color: var(--fg-3); font-family: var(--font-mono); }
  .portrait__cap b { color: var(--fg); font-weight: 600; }
  @media (max-width: 960px) {
    .home-hero__grid { grid-template-columns: 1fr; }
    .portrait { justify-self: start; width: min(100%, 280px); }
  }
  @media (prefers-reduced-motion: reduce) { .home-h1 { color: var(--fg); } }

  /* ---- Profile ---- */
  .home-about { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.6fr); gap: clamp(28px, 5vw, 72px); align-items: start; margin-bottom: 36px; }
  .home-about__text p { color: var(--fg-2); font-size: 1.08rem; max-width: 62ch; }
  .home-now { border-left: 2px solid var(--label); padding-left: 20px; display: grid; gap: 14px; }
  .home-now__list { display: grid; gap: 10px; font-size: 0.98rem; }
  .home-now__list li { display: grid; grid-template-columns: 10px 1fr; gap: 12px; align-items: start; color: var(--fg-2); }
  .home-now__dot { width: 8px; height: 8px; background: var(--label); margin-top: 8px; }
  .home-profile { margin-top: 32px; }
  @media (max-width: 760px) { .home-about { grid-template-columns: 1fr; } }

  /* ---- Capabilities ---- */
  .home-core { margin-top: -8px; }
  .home-core__item { display: grid; gap: 8px; align-content: start; padding-left: 14px; border-left: 1px solid var(--line-strong); }
  .home-core__item h3 { font-size: 1.25rem; letter-spacing: -0.015em; }
  .home-core__num { font-family: var(--font-mono); font-weight: 500; color: var(--label); font-size: 1rem; letter-spacing: 0.04em; }
  .home-core__sep { color: var(--line-strong); font-weight: 400; }
  .home-core__item p { color: var(--fg-2); font-size: 0.96rem; }
  .home-core__tools { font-family: var(--font-mono); font-size: 0.74rem !important; letter-spacing: 0.04em; color: var(--fg-3) !important; }
  .home-sub { font-size: clamp(1.3rem, 1.1rem + 0.8vw, 1.7rem); }
  .home-sub__note { color: var(--fg-3); font-size: 0.92rem; margin: 6px 0 22px; }
  .home-skills { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px 40px; margin-bottom: 32px; }
  .home-skillgroup__title { font-size: 0.74rem; margin-bottom: 10px; color: var(--label); font-family: var(--font-mono); font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; }
  .home-skill { font-family: var(--font-body); font-size: 0.9rem; padding: 9px 12px; gap: 8px; }
  .home-skill__n { display: inline-grid; place-items: center; min-width: 20px; height: 20px; padding: 0 6px; background: var(--accent-soft); color: var(--accent); font-family: var(--font-mono); font-size: 0.7rem; font-weight: 600; }
  .home-matrix .table th:first-child, .home-matrix .table td:first-child { position: sticky; left: 0; background: var(--bg-elev); z-index: 1; }
  .home-matrix .table thead th:first-child { background: var(--bg-sunk); z-index: 2; }
  .home-matrix__proj a { display: inline-flex; align-items: center; gap: 7px; color: var(--fg-2); text-decoration: none; white-space: nowrap; }
  .home-matrix__proj a:hover { color: var(--accent); }
  .home-matrix__skill { font: inherit; color: var(--fg); text-align: left; cursor: pointer; display: grid; gap: 2px; font-weight: 500; }
  .home-matrix__skill:hover { color: var(--label); }
  .home-matrix__group { font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--fg-3); font-weight: 400; }
  .home-matrix__cell { text-align: center; vertical-align: middle; }
  .home-matrix__yes { display: inline-grid; place-items: center; width: 24px; height: 24px; background: color-mix(in srgb, var(--swatch) 16%, transparent); color: var(--swatch); }
  .home-matrix__no { display: inline-block; width: 6px; height: 2px; background: var(--line-strong); }
  @media (max-width: 760px) { .home-skills { grid-template-columns: 1fr; } }

  /* ---- Selected work ---- */
  .home-work { display: grid; gap: 0; }
  .home-case { padding: clamp(28px, 4vw, 44px) 0; border-top: 1px solid var(--line-strong); }
  .home-case:last-child { border-bottom: 1px solid var(--line-strong); }
  .home-case__head { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 18px; }
  .home-case__body { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: clamp(24px, 4vw, 56px); align-items: start; }
  .home-case h3 { font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.4rem); letter-spacing: -0.025em; }
  .home-case h3 a { color: inherit; text-decoration: none; }
  .home-case h3 a:hover { color: var(--swatch-ink); }
  .home-case__line { margin-top: 8px; font-size: 1.1rem; color: var(--slate); font-weight: 500; }
  .home-case__meta { margin-top: 18px; }
  .home-case__summary { margin-top: 18px; color: var(--fg-2); font-size: 0.98rem; }
  .home-case__foot { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-top: 22px; }
  .home-case__panel { padding: clamp(16px, 2.4vw, 28px); border-top: 4px solid var(--swatch); min-height: 100%; }
  .home-case__panel :global(.hgfig__plot) { background: color-mix(in srgb, var(--bg) 8%, transparent); }
  .home-case__panel :global(.hgfig__cap) { color: color-mix(in srgb, var(--bg) 62%, transparent); }
  .home-case__panel :global(.hg text) { fill: color-mix(in srgb, var(--bg) 60%, transparent); }
  .home-case__panel :global(.hg .hg-cat) { fill: color-mix(in srgb, var(--bg) 82%, transparent); }
  .home-case__panel :global(.hg .hg-val) { fill: var(--bg); }
  .home-case__panel :global(.hg .hg-grid), .home-case__panel :global(.hg .hg-zero) { stroke: color-mix(in srgb, var(--bg) 22%, transparent); }
