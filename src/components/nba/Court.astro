---
/**
 * A half-court line drawing in wood tones. Decorative only (aria-hidden).
 * Proportions follow an NBA half court at 10 px per foot: 50 ft wide, 47 ft deep,
 * a 16 × 19 ft key, a 6 ft free-throw circle, the 23 ft 9 in three-point arc with
 * 22 ft corners, and the 4 ft restricted area.
 */
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<svg class:list={['nba-court', cls]} viewBox="0 0 500 470" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" preserveAspectRatio="xMidYMin meet">
  <path d="M0 0H500V470H0Z" />
  <path d="M170 0V190H330V0" />
  <path d="M250 130a60 60 0 1 0 0 120a60 60 0 1 0 0-120" />
  <path d="M30 0V140A237.5 237.5 0 0 0 470 140V0" />
  <path d="M210 52.5a40 40 0 0 0 80 0" />
  <path d="M220 40H280" />
  <path d="M250 45a7.5 7.5 0 1 0 0 15a7.5 7.5 0 1 0 0-15" />
  <path d="M190 470a60 60 0 0 1 120 0" />
</svg>
<style>
  .nba-court { color: var(--wood); opacity: 0.55; width: 100%; height: auto; }
</style>
