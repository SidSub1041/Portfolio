---
/**
 * The architecture schematic for the Sleeper tab, drawn as SVG strings at build time:
 * Sleeper REST -> transport (OkHttp, Retrofit, Gson) -> client groups -> POJOs -> your
 * code, with the error branch (ErrorUtils.parseError -> SleeperError) and the
 * synchronous call loop. Two layouts: `wide` for desktop, `tall` for phones. Every
 * stroke carries pathLength="1" so the shared `.draw` reveal animates it.
 * Content is read from SleeperApi.java, the *Impl classes, ErrorUtils.java and SleeperError.java.
 */
interface Props { layout: 'wide' | 'tall'; class?: string }
const { layout, class: cls = '' } = Astro.props;

const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const nb = (s: string) => s.replace(/^ +/, (m) => ' '.repeat(m.length));

interface Node { title: string; lines: string[]; extra?: string; tone?: 'accent' | 'neg' }
const nodes: Node[] = [
  { title: 'Sleeper REST', lines: ['api.sleeper.app', 'public GET endpoints', 'no key in the client', 'JSON responses'] },
  { title: 'Transport', lines: ['OkHttpClient', 'disk cache 2 MB (./cache)', 'Retrofit 2.6.0', 'GsonConverterFactory'] },
  { title: 'Client groups', lines: ['users()', 'leagues()', 'drafts()', 'players()', 'stats()', 'states() · protected'] },
  { title: 'POJOs', lines: ['User · League · Roster', 'Matchup · Transaction', 'Draft · DraftPick', 'Player · DepthChart', 'Stat · SportState'], extra: '+ footballDraft (fork)' },
  { title: 'Your code', lines: ['Sleeper sleeper =', '    new SleeperApi();', 'sleeper.users()', '    .getByUsername(name);'] },
];
const err: Node = { title: 'On failure', lines: ['!r.isSuccessful()', 'ErrorUtils.parseError(r)', 'throws SleeperError', '{ statusCode, message,', '  requestUrl }'], tone: 'neg' };

const edgeLabels = ['JSON over HTTP', 'Response<T>', 'r.body()', 'typed objects'];

function box(x: number, y: number, w: number, h: number, node: Node, delay: number, lh = 18): string {
  const tone = node.tone ?? 'accent';
  let s = `<g class="sl-schem__node sl-schem__node--${tone}">`;
  s += `<path class="sl-schem__box" pathLength="1" style="animation-delay:${delay}s" d="M${x} ${y}h${w}v${h}h${-w}Z"/>`;
  s += `<text class="sl-schem__title" x="${x + 14}" y="${y + 24}" font-size="11">${esc(node.title.toUpperCase())}</text>`;
  s += `<line class="sl-schem__rule" pathLength="1" style="animation-delay:${delay + 0.15}s" x1="${x + 14}" x2="${x + w - 14}" y1="${y + 34}" y2="${y + 34}"/>`;
  node.lines.forEach((l, i) => { s += `<text class="sl-schem__line" x="${x + 14}" y="${y + 56 + i * lh}" font-size="12">${esc(nb(l))}</text>`; });
  if (node.extra) s += `<text class="sl-schem__fork" x="${x + 14}" y="${y + 56 + node.lines.length * lh}" font-size="12">${esc(node.extra)}</text>`;
  return s + '</g>';
}

function arrow(x1: number, y1: number, x2: number, y2: number, label: string | null, delay: number, tone = ''): string {
  const t = tone ? ` sl-schem__edge--${tone}` : '';
  let s = `<line class="sl-schem__edge${t}" pathLength="1" style="animation-delay:${delay}s" x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}"/>`;
  const head = x2 !== x1
    ? (x2 > x1 ? `M${x2 - 9} ${y2 - 5}L${x2} ${y2}L${x2 - 9} ${y2 + 5}` : `M${x2 + 9} ${y2 - 5}L${x2} ${y2}L${x2 + 9} ${y2 + 5}`)
    : `M${x2 - 5} ${y2 - 9}L${x2} ${y2}L${x2 + 5} ${y2 - 9}`;
  s += `<path class="sl-schem__head${t}" pathLength="1" style="animation-delay:${delay + 0.25}s" d="${head}"/>`;
  if (label) {
    if (x2 !== x1) s += `<text class="sl-schem__label" x="${(x1 + x2) / 2}" y="${y1 - 9}" text-anchor="middle" font-size="11">${esc(label)}</text>`;
    else s += `<text class="sl-schem__label" x="${x1 + 10}" y="${(y1 + y2) / 2 + 4}" font-size="11">${esc(label)}</text>`;
  }
  return s;
}

let svg = '';
if (layout === 'wide') {
  const W = 1100, H = 470, bw = 184, gapX = 45, y = 40, bh = 220;
  const xs = nodes.map((_, i) => i * (bw + gapX));
  svg += `<svg class="sl-schem sl-schem--wide ${cls}" viewBox="0 0 ${W} ${H}" role="img" aria-label="How a call flows: Sleeper REST to the Retrofit transport, to the client groups, to plain Java objects, to your code; failed responses become a SleeperError" preserveAspectRatio="xMidYMid meet">`;
  nodes.forEach((node, i) => { svg += box(xs[i], y, bw, bh, node, i * 0.25); });
  for (let i = 0; i < nodes.length - 1; i++) svg += arrow(xs[i] + bw, y + 110, xs[i + 1], y + 110, edgeLabels[i], 0.2 + i * 0.25);
  svg += box(xs[2], 320, bw, 140, err, 1.2);
  svg += arrow(xs[2] + bw / 2, y + bh, xs[2] + bw / 2, 320, '!r.isSuccessful()', 1.0, 'neg');
  const loopStart = xs[4] + bw / 2, loopEnd = xs[0] + bw / 2;
  svg += `<path class="sl-schem__loop" pathLength="1" style="animation-delay:1.3s" d="M${loopStart} ${y}V16H${loopEnd}V${y}"/>`;
  svg += `<path class="sl-schem__head sl-schem__head--loop" pathLength="1" style="animation-delay:1.6s" d="M${loopEnd - 5} ${y - 9}L${loopEnd} ${y}L${loopEnd + 5} ${y - 9}"/>`;
  svg += `<text class="sl-schem__label" x="${W / 2}" y="11" text-anchor="middle" font-size="11">every call is synchronous: the Impl runs retrofit.create(...).execute() and returns the body</text>`;
  svg += '</svg>';
} else {
  const W = 390, bx = 32, bw = 330, bh = 150, gapY = 40, y0 = 40;
  const ys = nodes.map((_, i) => y0 + i * (bh + gapY));
  const ey = ys[4] + bh + gapY, eh = 130, H = ey + eh + 16;
  svg += `<svg class="sl-schem sl-schem--tall ${cls}" viewBox="0 0 ${W} ${H}" role="img" aria-label="How a call flows: Sleeper REST to the Retrofit transport, to the client groups, to plain Java objects, to your code; failed responses become a SleeperError" preserveAspectRatio="xMidYMid meet">`;
  nodes.forEach((node, i) => { svg += box(bx, ys[i], bw, bh, node, i * 0.25, 17); });
  for (let i = 0; i < nodes.length - 1; i++) svg += arrow(bx + bw / 2, ys[i] + bh, bx + bw / 2, ys[i + 1], edgeLabels[i], 0.2 + i * 0.25);
  svg += box(bx, ey, bw, eh, err, 1.3, 17);
  const branchY = ys[2] + bh / 2, errMid = ey + eh / 2;
  svg += `<path class="sl-schem__edge sl-schem__edge--neg" pathLength="1" style="animation-delay:1.1s" d="M${bx} ${branchY}H14V${errMid}H${bx - 1}"/>`;
  svg += `<path class="sl-schem__head sl-schem__head--neg" pathLength="1" style="animation-delay:1.4s" d="M${bx - 9} ${errMid - 5}L${bx} ${errMid}L${bx - 9} ${errMid + 5}"/>`;
  svg += `<text class="sl-schem__label" x="${bx + 10}" y="${ey - 10}" font-size="11">!r.isSuccessful()</text>`;
  const youMid = ys[4] + bh / 2, restMid = ys[0] + bh / 2;
  svg += `<path class="sl-schem__loop" pathLength="1" style="animation-delay:1.3s" d="M${bx + bw} ${youMid}H378V${restMid}H${bx + bw + 1}"/>`;
  svg += `<path class="sl-schem__head sl-schem__head--loop" pathLength="1" style="animation-delay:1.6s" d="M${bx + bw + 9} ${restMid - 5}L${bx + bw} ${restMid}L${bx + bw + 9} ${restMid + 5}"/>`;
  svg += `<text class="sl-schem__label" transform="rotate(90 382 ${(youMid + restMid) / 2})" x="382" y="${(youMid + restMid) / 2}" text-anchor="middle" font-size="11">synchronous call: .execute()</text>`;
  svg += '</svg>';
}
---
<Fragment set:html={svg} />
