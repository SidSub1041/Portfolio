---
/**
 * The hero "drawing sheet": a treemap of the Java packages (cell area = files in the
 * group, from sleeper.json), framed like an engineering sheet with a title block whose
 * fields come from settings.gradle, build.gradle and .circleci/config.yml.
 */
import sleeper from '../../data/sleeper.json';
import { build } from './data';

const groups = sleeper.groups as Record<string, string[]>;
const total = Object.values(groups).reduce((a, c) => a + c.length, 0);
const rowA = ['League', 'Draft', 'Player'];
const rowB = ['Other', 'Stats', 'User', '(root)', 'Errors'];
const W = 480, H = 300, pad = 8, gap = 6;
const count = (g: string) => groups[g].length;
const sum = (gs: string[]) => gs.reduce((a, g) => a + count(g), 0);
const innerH = H - pad * 2 - gap;
const hA = Math.round((innerH * sum(rowA)) / total);
const hB = innerH - hA;
const n = (v: number) => (Math.round(v * 10) / 10).toString();
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const short = (s: string) => s.split('.').pop() ?? s;

interface Cell { g: string; x: number; y: number; w: number; h: number }
function layoutRow(gs: string[], y: number, h: number): Cell[] {
  const innerW = W - pad * 2 - gap * (gs.length - 1);
  const tot = sum(gs);
  let x = pad;
  return gs.map((g) => {
    const w = (innerW * count(g)) / tot;
    const cell = { g, x, y, w, h };
    x += w + gap;
    return cell;
  });
}
const cells = [...layoutRow(rowA, pad, hA), ...layoutRow(rowB, pad + hA + gap, hB)];

let svg = `<svg class="sl-tm" viewBox="0 0 ${W} ${H}" role="img" aria-label="Package layout of the client, ${total} files: ${cells.map((c) => `${c.g} ${count(c.g)}`).join(', ')}" preserveAspectRatio="xMidYMid meet">`;
for (const c of cells) {
  const isDraft = c.g === 'Draft';
  const classes = groups[c.g].map(short).filter((name) => !(isDraft && name === 'footballDraft'));
  const files = count(c.g);
  svg += `<g class="sl-tm__cell${isDraft ? ' sl-tm__cell--fork' : ''}" data-group="${esc(c.g)}" tabindex="0" role="button" aria-label="${esc(c.g)}: ${files} files, show the group card">`;
  svg += `<path class="sl-tm__box" pathLength="1" d="M${n(c.x)} ${n(c.y)}h${n(c.w)}v${n(c.h)}h${n(-c.w)}Z"/>`;
  svg += `<text class="sl-tm__name" x="${n(c.x + 10)}" y="${n(c.y + 22)}" font-size="13">${esc(c.g === '(root)' ? 'root' : c.g)}</text>`;
  svg += `<text class="sl-tm__count" x="${n(c.x + 10)}" y="${n(c.y + 39)}" font-size="11">${files} file${files === 1 ? '' : 's'}</text>`;
  if (c.h >= 110 && c.w >= 120) {
    const reserve = isDraft ? 22 : 0;
    const max = Math.min(classes.length, Math.floor((c.h - 58 - reserve) / 15));
    classes.slice(0, max).forEach((name, i) => {
      svg += `<text class="sl-tm__cls" x="${n(c.x + 10)}" y="${n(c.y + 60 + i * 15)}" font-size="10.5">${esc(name)}</text>`;
    });
    if (classes.length > max) svg += `<text class="sl-tm__cls" x="${n(c.x + 10)}" y="${n(c.y + 60 + max * 15)}" font-size="10.5">+${classes.length - max} more</text>`;
  }
  if (isDraft) svg += `<text class="sl-tm__fork" x="${n(c.x + 10)}" y="${n(c.y + c.h - 12)}" font-size="10.5">+ footballDraft (fork)</text>`;
  svg += '</g>';
}
svg += '</svg>';
---
<div class="sl-sheet reveal reveal--scale" style="--i:3" id="sl-sheet">
  <div class="sl-sheet__head"><span>Sheet 1 / 1</span><span>Package layout · com.sdcalmes.sleeper</span><span>Area = files</span></div>
  <div class="sl-sheet__body draw"><Fragment set:html={svg} /></div>
  <dl class="sl-tb">
    <div><dt>Project</dt><dd>{build.rootProject}</dd></div>
    <div><dt>Artifact</dt><dd>{build.artifact} {build.version}</dd></div>
    <div><dt>Target</dt><dd>Java {build.java}</dd></div>
    <div><dt>Build</dt><dd>Gradle · shadow 5.1.0</dd></div>
    <div><dt>HTTP</dt><dd>Retrofit 2.6.0 · OkHttp</dd></div>
    <div><dt>JSON</dt><dd>Gson 2.8.9</dd></div>
    <div><dt>Tests</dt><dd>JUnit 4.12 · {sleeper.tests.length} classes</dd></div>
    <div><dt>CI</dt><dd>CircleCI · openjdk:8-jdk</dd></div>
  </dl>
  <div class="sl-sheet__foot"><span>Click a cell to jump to its group</span><button type="button" class="sl-link" data-dialog-open="sl-build">Build and CI details</button></div>
</div>
