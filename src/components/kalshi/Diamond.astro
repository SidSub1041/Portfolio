---
/**
 * Decorative baseball-diamond line drawing for the Kalshi hero. Thin strokes in the current
 * colour; every path carries pathLength="1" so the shared `.draw` animation traces it in.
 * Geometry: home plate at (260,430), bases 170 px apart, fence arc centred on home.
 */
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<svg class:list={['kx-diamond', cls]} viewBox="0 0 520 520" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
  <path d="M0 88 A430 430 0 0 1 520 88" pathLength="1" opacity=".55"/>
  <line x1="260" y1="430" x2="0" y2="170" pathLength="1"/>
  <line x1="260" y1="430" x2="520" y2="170" pathLength="1"/>
  <path d="M89.2 259.2 A180 180 0 0 1 430.8 259.2" pathLength="1" opacity=".8"/>
  <path d="M260 430 L380 310 L260 190 L140 310 Z" pathLength="1" stroke-width="1.6"/>
  <path d="M244 316 a16 16 0 1 0 32 0 a16 16 0 1 0 -32 0" pathLength="1"/>
  <line x1="254" y1="316" x2="266" y2="316" pathLength="1" stroke-width="2"/>
  <rect x="371" y="301" width="18" height="18" transform="rotate(45 380 310)" opacity=".9"/>
  <rect x="251" y="181" width="18" height="18" transform="rotate(45 260 190)" opacity=".9"/>
  <rect x="131" y="301" width="18" height="18" transform="rotate(45 140 310)" opacity=".9"/>
  <path d="M251 419 h18 v8 l-9 9 l-9 -9 z" pathLength="1"/>
  <rect x="222" y="406" width="22" height="42" opacity=".7"/>
  <rect x="276" y="406" width="22" height="42" opacity=".7"/>
  <path d="M138 450 a12 12 0 1 0 24 0 a12 12 0 1 0 -24 0" pathLength="1" opacity=".5"/>
  <path d="M358 450 a12 12 0 1 0 24 0 a12 12 0 1 0 -24 0" pathLength="1" opacity=".5"/>
</svg>
